<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="Window">
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style Selector="Menu">
        <Setter Property="Background" Value="#2C2C2E"/>
    </Style>

    <Style Selector="ContextMenu">
        <Setter Property="Background" Value="#2D2D30"/>
        <Setter Property="BorderBrush" Value="#3F3F46"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style Selector="MenuItem">
        <Setter Property="Background" Value="#2D2D30"/>
        <Setter Property="Foreground" Value="#CCCCCC"/>
    </Style>

    <Style Selector="MenuItem:pointerover">
        <Setter Property="Background" Value="#0078D4"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style Selector="Border.Panel">
        <Setter Property="Background" Value="#252526"/>
        <Setter Property="BorderBrush" Value="#3F3F46"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style Selector="Border.ThemePanel">
        <Setter Property="Background" Value="#2C2C2E"/>
        <Setter Property="BorderBrush" Value="#3F3F46"/>
    </Style>

    <Style Selector="Border.ThemeRuler">
        <Setter Property="Background" Value="#252526"/>
        <Setter Property="BorderBrush" Value="#3F3F46"/>
    </Style>

    <Style Selector="Border.DarkSeparator">
        <Setter Property="Background" Value="#3F3F46"/>
    </Style>

    <Style Selector="Separator.DarkSeparator">
        <Setter Property="Background" Value="#3F3F46"/>
    </Style>

    <Style Selector="Grid.MainForeGround">
        <Setter Property="Background" Value="#000000"/>
    </Style>

    <Style Selector="Grid.MainTheme">
        <Setter Property="Background" Value="#1C1C1E"/>
    </Style>

    <Style Selector="StackPanel.ParamBackground">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style Selector="Window[RequestedThemeVariant=Light]">
        <Setter Property="Background" Value="#F5F5F5"/>
    </Style>

    <Style Selector="Window[RequestedThemeVariant=Light] Menu">
        <Setter Property="Background" Value="#FFFFFF"/>
    </Style>

    <Style Selector="Window[RequestedThemeVariant=Light] MenuItem">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="Foreground" Value="#333333"/>
    </Style>

    <Style Selector="Window[RequestedThemeVariant=Light] ContextMenu">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#D0D0D0"/>
        <Setter Property="Foreground" Value="#333333"/>
    </Style>

    <Style Selector="Window[RequestedThemeVariant=Light] Border.Panel">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#D0D0D0"/>
    </Style>

    <Style Selector="Window[RequestedThemeVariant=Light] Border.ThemePanel">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="#D0D0D0"/>
    </Style>

    <Style Selector="Window[RequestedThemeVariant=Light] Border.ThemeRuler">
        <Setter Property="Background" Value="#F5F5F5"/>
        <Setter Property="BorderBrush" Value="#D0D0D0"/>
    </Style>

    <Style Selector="Window[RequestedThemeVariant=Light] Border.ThemeRuler TextBlock">
        <Setter Property="Foreground" Value="#777777"/>
    </Style>

    <Style Selector="Window[RequestedThemeVariant=Light] Border.DarkSeparator">
        <Setter Property="Background" Value="#D0D0D0"/>
    </Style>

    <Style Selector="Window[RequestedThemeVariant=Light] Separator.DarkSeparator">
        <Setter Property="Background" Value="#D0D0D0"/>
    </Style>

    <Style Selector="Window[RequestedThemeVariant=Light] Grid.MainForeGround">
        <Setter Property="Background" Value="#FFFFFF"/>
    </Style>

    <Style Selector="Window[RequestedThemeVariant=Light] Grid.MainTheme">
        <Setter Property="Background" Value="#333333"/>
    </Style>

    <Style Selector="Window[RequestedThemeVariant=Light] StackPanel.ParamBackground">
        <Setter Property="Background" Value="#FFFFFF"/>
    </Style>

    <Style Selector="Window[RequestedThemeVariant=Light] TextBox">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="Foreground" Value="#333333"/>
        <Setter Property="BorderBrush" Value="#D0D0D0"/>
    </Style>

    <Style Selector="Window[RequestedThemeVariant=Light] ComboBox">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="Foreground" Value="#333333"/>
        <Setter Property="BorderBrush" Value="#D0D0D0"/>
    </Style>

    <Style Selector="Window[RequestedThemeVariant=Light] ListBox">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="Foreground" Value="#333333"/>
        <Setter Property="BorderBrush" Value="#D0D0D0"/>
    </Style>

    <Style Selector="Window[RequestedThemeVariant=Light] TabItem">
        <Setter Property="Background" Value="#F5F5F5"/>
        <Setter Property="Foreground" Value="#333333"/>
    </Style>

    <Style Selector="Window[RequestedThemeVariant=Light] TabItem:selected">
        <Setter Property="Background" Value="#FFFFFF"/>
    </Style>

    <Style Selector="Window[RequestedThemeVariant=Light] GridSplitter">
        <Setter Property="Background" Value="#E0E0E0"/>
    </Style>
</Styles>

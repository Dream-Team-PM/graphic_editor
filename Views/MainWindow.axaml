<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1920" d:DesignHeight="1080"
        x:Class="graphic_editor.MainWindow"
        xmlns:local="using:graphic_editor.Controls"
        xmlns:converters="using:graphic_editor.Converters"
        xmlns:vm="using:graphic_editor.ViewModels"
        Title="INKognida — Безымянный.vec"
        Background="#1C1C1E"
        WindowState="Maximized"
        RequestedThemeVariant="Dark"
        FontFamily="Segoe UI, system-ui">

    <Window.Resources>
        <DrawingBrush x:Key="CheckerBrush" 
                      TileMode="Tile" 
                      DestinationRect="0,0,16,16">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#252526" Geometry="M0,0 L16,0 16,16 0,16 Z"/>
                    <GeometryDrawing Brush="#2F2F32" Geometry="M0,0 L8,0 8,8 0,8 Z M8,8 L16,8 16,16 8,16 Z"/>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <converters:InvertedBoolConverter x:Key="InvertedBool"/>
        <converters:IsZeroToVisibleConverter x:Key="IsZeroToVisible"/>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Window">
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style Selector="Menu">
            <Setter Property="Background" Value="#2C2C2E"/>
        </Style>

        <!-- Tool buttons (RadioButton для взаимоисключения) -->
        <Style Selector="RadioButton.ToolButton">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="22"/>
        </Style>
        <Style Selector="RadioButton.ToolButton:pointerover">
            <Setter Property="Background" Value="#3C3C3E"/>
        </Style>
        <Style Selector="RadioButton.ToolButton:checked">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Border.Panel">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Стили для контекстного меню -->
        <Style Selector="ContextMenu">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="MenuItem">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
        </Style>
        <Style Selector="MenuItem:pointerover">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>


        <!-- ========== СВЕТЛАЯ ТЕМА (переопределения) ========== -->
        <Style Selector="Window[RequestedThemeVariant=Light]">
            <Setter Property="Background" Value="#F5F5F5"/>
        </Style>
        
        <Style Selector="Window[RequestedThemeVariant=Light] Menu">
            <Setter Property="Background" Value="#FFFFFF"/>
        </Style>
        
        <Style Selector="Window[RequestedThemeVariant=Light] Border.Panel">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
        </Style>
        
        <Style Selector="Window[RequestedThemeVariant=Light] RadioButton.ToolButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>
        <Style Selector="Window[RequestedThemeVariant=Light] RadioButton.ToolButton:pointerover">
            <Setter Property="Background" Value="#E5E5E5"/>
        </Style>
        <Style Selector="Window[RequestedThemeVariant=Light] RadioButton.ToolButton:checked">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        
        <Style Selector="Window[RequestedThemeVariant=Light] ContextMenu">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>
        <Style Selector="Window[RequestedThemeVariant=Light] MenuItem:pointerover">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        
        <!-- Холст: светлая шахматная подложка -->
        <Style Selector="Window[RequestedThemeVariant=Light] Border#CanvasBorder">
            <Setter Property="Background">
                <Setter.Value>
                    <DrawingBrush TileMode="Tile" DestinationRect="0,0,16,16">
                        <DrawingBrush.Drawing>
                            <DrawingGroup>
                                <GeometryDrawing Brush="#FFFFFF" Geometry="M0,0 L16,0 16,16 0,16 Z"/>
                                <GeometryDrawing Brush="#F0F0F0" Geometry="M0,0 L8,0 8,8 0,8 Z M8,8 L16,8 16,16 8,16 Z"/>
                            </DrawingGroup>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#0078D4"/>
        </Style>
        
        <!-- Текст на холсте для светлой темы -->
        <Style Selector="Window[RequestedThemeVariant=Light] TextBlock">

        </Style>

        <!-- ========== СВЕТЛАЯ ТЕМА - ИСПРАВЛЕННЫЕ СТИЛИ ========== -->

        <!-- Панели (параметры, вкладки) -->
        <Style Selector="Window[RequestedThemeVariant=Light] Border.ThemePanel">
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
        </Style>

        <Style Selector="Window[RequestedThemeVariant=Dark] Border.ThemePanel">
            <Setter Property="Background" Value="#2C2C2E"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
        </Style>

        <!-- Линейки -->
        <Style Selector="Window[RequestedThemeVariant=Light] Border.ThemeRuler">
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
        </Style>

        <!-- Статус-бар -->
        <Style Selector="Window[RequestedThemeVariant=Light] Border.ThemeStatusBar">
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
        </Style>



        <!-- Текст в панелях и статус-баре -->
        <Style Selector="Window[RequestedThemeVariant=Light] Border.ThemePanel TextBlock[Foreground=#999999]">
          <Setter Property="Foreground" Value="#666666"/>
        </Style>
        <Style Selector="Window[RequestedThemeVariant=Light] Border.ThemeStatusBar TextBlock">
          <Setter Property="Foreground" Value="#333333"/>
        </Style>

        <!-- Текст на линейках -->
        <Style Selector="Window[RequestedThemeVariant=Light] Border.ThemeRuler TextBlock">
            <Style Selector="^[Foreground=#888]">
                <Setter Property="Foreground" Value="#777777"/>
            </Style>
        </Style>

        <!-- Текст на холсте -->
        <Style Selector="Window[RequestedThemeVariant=Light] TextBlock[Foreground=#555555]">
            <Setter Property="Foreground" Value="#AAAAAA"/>
        </Style>

        <!-- Линия на холсте -->
        <Style Selector="Window[RequestedThemeVariant=Light] Line[Stroke=#3A3A3C]">
            <Setter Property="Stroke" Value="#CCCCCC"/>
        </Style>

        <!-- TextBox в правой панели -->
        <Style Selector="Window[RequestedThemeVariant=Light] TextBox[Background=#3C3C3E]">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
        </Style>

        <!-- Border для превью цвета/обводки -->
        <Style Selector="Window[RequestedThemeVariant=Light] Border[BorderBrush=#555]">
            <Setter Property="BorderBrush" Value="#BBBBBB"/>
        </Style>
        <Style Selector="Window[RequestedThemeVariant=Light] Border[BorderBrush=#FFFFFF]">
            <Setter Property="BorderBrush" Value="#333333"/>
        </Style>
        
        <!-- ScrollViewer -->
        <Style Selector="Window[RequestedThemeVariant=Light] ScrollViewer">
            <Setter Property="Background" Value="#FFFFFF"/>
        </Style>

        <!-- GridSplitter -->
        <Style Selector="Window[RequestedThemeVariant=Light] GridSplitter">
            <Setter Property="Background" Value="#E0E0E0"/>
        </Style>

        <!-- ListBox в слоях -->
        <Style Selector="Window[RequestedThemeVariant=Light] ListBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>

        <Style Selector="Window[RequestedThemeVariant=Light] ListBoxItem">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>

        <!-- TabControl -->
        <Style Selector="Window[RequestedThemeVariant=Light] TabControl">
            <Setter Property="Background" Value="#FFFFFF"/>
        </Style>

        <!-- Меню в светлой теме -->
        <Style Selector="Window[RequestedThemeVariant=Light] Menu MenuItem">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>

        <Style Selector="Window[RequestedThemeVariant=Light] Menu Separator">
            <Setter Property="Background" Value="#D0D0D0"/>
        </Style>
        
        <!-- ComboBox в панели параметров -->
        <Style Selector="Window[RequestedThemeVariant=Light] ComboBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
        </Style>

        <Style Selector="Window[RequestedThemeVariant=Light] TabItem">
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>

        <Style Selector="Window[RequestedThemeVariant=Light] TabItem:selected">
            <Setter Property="Background" Value="#FFFFFF"/>
        </Style>

        <!-- Разделители -->
        <Style Selector="Window[RequestedThemeVariant=Light] Border.DarkSeparator">
            <Setter Property="Background" Value="#D0D0D0"/>
        </Style>
        <Style Selector="Window[RequestedThemeVariant=Light] Separator.DarkSeparator">
            <Setter Property="Background" Value="#D0D0D0"/>
        </Style>

        <!-- Иконки темы -->
        <Style Selector="Window[RequestedThemeVariant=Light] TextBlock.ThemeIcon">
            <Setter Property="Foreground" Value="#333333"/>
        </Style>

        <!-- Кнопки действий (↶ ↷) -->
        <Style Selector="Window[RequestedThemeVariant=Light] Button.ToolActionBtn">
            <Setter Property="Background" Value="#E0E0E0"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>

        <!-- ========== СВЕТЛАЯ ТЕМА - УЛУЧШЕННАЯ ВЕРСИЯ ========== -->

        <!-- Выпадающие меню -->
        <Style Selector="Window[RequestedThemeVariant=Light] MenuItem">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>

        <Style Selector="Window[RequestedThemeVariant=Light] Menu Separator">
            <Setter Property="Background" Value="#D0D0D0"/>
        </Style>

        <!-- Контекстное меню -->
        <Style Selector="Window[RequestedThemeVariant=Light] ContextMenu">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>

        <!-- Кнопки отмены/повтора -->
        <Style Selector="Window[RequestedThemeVariant=Light] Button">
            <Setter Property="Background" Value="#E8E8E8"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>

        <Style Selector="Window[RequestedThemeVariant=Light] Button:pointerover">
            <Setter Property="Background" Value="#D0D0D0"/>
        </Style>

        <!-- Разделители - используем классы -->
        <Style Selector="Window[RequestedThemeVariant=Light] Separator">
            <Setter Property="Background" Value="#D0D0D0"/>
        </Style>

        <Style Selector="Window[RequestedThemeVariant=Light] Border.MenuSeparator">
            <Setter Property="Background" Value="#D0D0D0"/>
        </Style>

        <!-- TextBox в панелях -->
        <Style Selector="Window[RequestedThemeVariant=Light] TextBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
        </Style>

        <!-- ComboBox -->
        <Style Selector="Window[RequestedThemeVariant=Light] ComboBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
        </Style>

        <Style Selector="Window[RequestedThemeVariant=Light] ComboBoxItem">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>

        <Style Selector="Window[RequestedThemeVariant=Light] ComboBoxItem:pointerover">
            <Setter Property="Background" Value="#E5E5E5"/>
        </Style>

        <!-- ListBox -->
        <Style Selector="Window[RequestedThemeVariant=Light] ListBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
        </Style>

        <Style Selector="Window[RequestedThemeVariant=Light] ListBoxItem">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>

        <Style Selector="Window[RequestedThemeVariant=Light] ListBoxItem:selected">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- TabControl -->
        <Style Selector="Window[RequestedThemeVariant=Light] TabControl">
            <Setter Property="Background" Value="#FFFFFF"/>
        </Style>

        <Style Selector="Window[RequestedThemeVariant=Light] TabItem">
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>

        <Style Selector="Window[RequestedThemeVariant=Light] TabItem:selected">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0078D4"/>
        </Style>

        <Style Selector="Window[RequestedThemeVariant=Light] TabItem:pointerover">
            <Setter Property="Background" Value="#E8E8E8"/>
        </Style>

        <!-- Slider -->
        <Style Selector="Window[RequestedThemeVariant=Light] Slider">
            <Setter Property="Background" Value="#E0E0E0"/>
        </Style>

        <!-- GridSplitter -->
        <Style Selector="Window[RequestedThemeVariant=Light] GridSplitter">
            <Setter Property="Background" Value="#E0E0E0"/>
        </Style>

        <!-- ScrollViewer -->
        <Style Selector="Window[RequestedThemeVariant=Light] ScrollViewer">
            <Setter Property="Background" Value="#FFFFFF"/>
        </Style>

        <!-- CheckBox -->
        <Style Selector="Window[RequestedThemeVariant=Light] CheckBox">
            <Setter Property="Foreground" Value="#333333"/>
        </Style>

        <!-- TextBlock в статус-баре и панелях -->
        <Style Selector="Window[RequestedThemeVariant=Light] Border.ThemePanel TextBlock, Window[RequestedThemeVariant=Light] Border.ThemeStatusBar TextBlock">
            <Setter Property="Foreground" Value="#333333"/>
        </Style>

        <!-- Иконки темы -->
        <Style Selector="Window[RequestedThemeVariant=Light] TextBlock.ThemeIcon">
            <Setter Property="Foreground" Value="#333333"/>
        </Style>

        <!-- Холст - светлая шахматка -->
        <Style Selector="Window[RequestedThemeVariant=Light] Border#CanvasBorder">
            <Setter Property="Background">
                <Setter.Value>
                    <DrawingBrush TileMode="Tile" DestinationRect="0,0,16,16">
                        <DrawingBrush.Drawing>
                            <DrawingGroup>
                                <GeometryDrawing Brush="#FFFFFF" Geometry="M0,0 L16,0 16,16 0,16 Z"/>
                                <GeometryDrawing Brush="#F0F0F0" Geometry="M0,0 L8,0 8,8 0,8 Z M8,8 L16,8 16,16 8,16 Z"/>
                            </DrawingGroup>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#0078D4"/>
        </Style>

        <!-- Текст на холсте -->
        <Style Selector="Window[RequestedThemeVariant=Light] TextBlock.CanvasText">
            <Setter Property="Foreground" Value="#666666"/>
        </Style>

        <!-- Line на холсте -->
        <Style Selector="Window[RequestedThemeVariant=Light] Line">
            <Setter Property="Stroke" Value="#CCCCCC"/>
        </Style>

        <!-- Border для превью цвета -->
        <Style Selector="Window[RequestedThemeVariant=Light] Border.ColorPreview">
            <Setter Property="BorderBrush" Value="#BBBBBB"/>
        </Style>

        <!-- Вкладки документов -->
        <Style Selector="Window[RequestedThemeVariant=Light] Border.DocumentTab">
            <Setter Property="Background" Value="#BCBCBC"/>
        </Style>

        <Style Selector="Window[RequestedThemeVariant=Dark] Border.DocumentTab">
            <Setter Property="Background" Value="#252526"/>
        </Style>

        <Style Selector="Window[RequestedThemeVariant=Light] Border.DocumentTab TextBlock">
            <Setter Property="Foreground" Value="#333333"/>
        </Style>

        <!-- ========== СВЕТЛАЯ ТЕМА - ЛИНЕЙКИ И ПАНЕЛИ ========== -->

        <!-- Линейки (горизонтальная и вертикальная) -->
        <Style Selector="Window[RequestedThemeVariant=Light] Border.ThemeRuler">
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
        </Style>

        <Style Selector="Window[RequestedThemeVariant=Light] Border.ThemeRuler TextBlock">
            <Setter Property="Foreground" Value="#777777"/>
        </Style>

        <Style Selector="Window[RequestedThemeVariant=Dark] Border.ThemeRuler">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
        </Style>

        <Style Selector="Window[RequestedThemeVariant=Dark] Border.ThemeRuler TextBlock">
            <Setter Property="Foreground" Value="#888888"/>
        </Style>

        <!-- Контекстная панель параметров -->
        <Style Selector="Window[RequestedThemeVariant=Light] Border.ThemePanel">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
        </Style>

        <Style Selector="Window[RequestedThemeVariant=Dark] Border.ThemePanel">
            <Setter Property="Background" Value="#2C2C2E"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
        </Style>

        <!-- Текст в панелях -->
        <Style Selector="Window[RequestedThemeVariant=Light] Border.ThemePanel TextBlock">
            <Setter Property="Foreground" Value="#333333"/>
        </Style>

        

        <!-- Кнопки действий (↶ ↷) -->
        <Style Selector="Window[RequestedThemeVariant=Light] Button.ToolActionBtn">
            <Setter Property="Background" Value="#E8E8E8"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="Window[RequestedThemeVariant=Light] Button.ToolActionBtn:pointerover">
            <Setter Property="Background" Value="#D0D0D0"/>
        </Style>

        <Style Selector="Window[RequestedThemeVariant=Light] Button.ToolActionBtn:pressed">
            <Setter Property="Background" Value="#C0C0C0"/>
        </Style>

        <!-- Разделитель в верхней панели -->
        <Style Selector="Window[RequestedThemeVariant=Light] Border.DarkSeparator">
            <Setter Property="Background" Value="#D0D0D0"/>
        </Style>

        <Style Selector="Window[RequestedThemeVariant=Light] Separator.DarkSeparator">
            <Setter Property="Background" Value="#D0D0D0"/>
        </Style>

        <!-- Иконки темы (🌙 ☀️) -->
        <Style Selector="Window[RequestedThemeVariant=Light] TextBlock.ThemeIcon">
            <Setter Property="Foreground" Value="#333333"/>
        </Style>

        <!-- Слайдер темы -->
        <Style Selector="Window[RequestedThemeVariant=Light] Slider">
            <Setter Property="Background" Value="#E0E0E0"/>
        </Style>

        <!-- ComboBox в панели параметров -->
        <Style Selector="Window[RequestedThemeVariant=Light] ComboBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#D0D0D0"/>
        </Style>

        <Style Selector="Window[RequestedThemeVariant=Light] ComboBoxItem">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>

        <Style Selector="Window[RequestedThemeVariant=Light] ComboBoxItem:pointerover">
            <Setter Property="Background" Value="#E5E5E5"/>
        </Style>

        <!-- Border для превью цвета -->
        <Style Selector="Window[RequestedThemeVariant=Light] Border.ColorPreview">
            <Setter Property="BorderBrush" Value="#BBBBBB"/>
        </Style>

        <Style Selector="Window[RequestedThemeVariant=Light] Border.Styling">
            <Setter Property="BorderBrush" Value="#000000"/>
        </Style>
        <Style Selector="Window[RequestedThemeVariant=Dark] Border.Styling">
            <Setter Property="BorderBrush" Value="#FFFFFF"/>
        </Style>

        <Style Selector="Window[RequestedThemeVariant=Light] Grid.MainForeGround">
            <Setter Property="Background" Value="#FFFFFF"/>
        </Style>

        <Style Selector="Window[RequestedThemeVariant=Dark] Grid.MainForeGround">
            <Setter Property="Background" Value="#000000"/>
        </Style>

        <Style Selector="Window[RequestedThemeVariant=Light] Grid.MainTheme">
            <Setter Property="Background" Value="#333333"/>
        </Style>

        <Style Selector="Window[RequestedThemeVariant=Light] StackPanel.ParamBackground">
            <Setter Property="Background" Value="#FFFFFF"/>
        </Style>

        
    </Window.Styles>

    <Grid Classes="MainTheme" RowDefinitions="Auto,Auto,*,Auto" ColumnDefinitions="Auto,*,Auto">

        <!-- 1. Главное меню -->
        <Border Grid.Row="0" Grid.ColumnSpan="3" Classes="ThemePanel" Height="32">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Меню слева -->
                <Menu Grid.Column="0" Background="Transparent" HorizontalAlignment="Left">
                    <MenuItem Header="_Файл">
                        <MenuItem Header="Новый…" InputGesture="Ctrl+N"/>
                        <MenuItem Header="Открыть…" InputGesture="Ctrl+O"/>
                        <MenuItem Header="Сохранить" InputGesture="Ctrl+S"/>
                        <MenuItem Header="Сохранить как…" InputGesture="Ctrl+Shift+S"/>
                        <Separator/>
                        <MenuItem Header="Выход" InputGesture="Alt+F4"/>
                    </MenuItem>
                    <MenuItem Header="_Правка">
                        <MenuItem Header="Отменить" InputGesture="Ctrl+Z"/>
                        <MenuItem Header="Повторить" InputGesture="Ctrl+Y"/>
                        <Separator/>
                        <MenuItem Header="Вырезать" InputGesture="Ctrl+X"/>
                        <MenuItem Header="Копировать" InputGesture="Ctrl+C"/>
                        <MenuItem Header="Вставить" InputGesture="Ctrl+V"/>
                    </MenuItem>
                    <MenuItem Header="_Вид">
                        <MenuItem Header="Показать линейки" IsChecked="True"/>
                        <MenuItem Header="Показать сетку" IsChecked="True"/>
                        <Separator/>
                        <MenuItem Header="Приблизить" InputGesture="Ctrl+OemPlus"/>
                        <MenuItem Header="Отдалить" InputGesture="Ctrl+OemMinus"/>
                        <MenuItem Header="Масштаб 100%" InputGesture="Ctrl+0"/>
                    </MenuItem>
                    <MenuItem Header="_Слой"/>
                    <MenuItem Header="_Объект"/>
                    <MenuItem Header="_Справка"/>
                </Menu>

                <!-- Кнопки и переключатель темы справа -->
                <StackPanel Classes="Switcher" Grid.Column="1" Orientation="Horizontal" 
                            VerticalAlignment="Center" Margin="0,0,14,0" Spacing="4">
                    
                    <!-- Кнопки с центрированием содержимого -->
                    <Button Classes="ToolActionBtn" Content="↶" Width="32" Height="24" 
                            VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                            ToolTip.Tip="Отменить (Ctrl+Z)"/>
                    
                    <Button Classes="ToolActionBtn" Content="↷" Width="32" Height="24"
                            VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                            ToolTip.Tip="Повторить (Ctrl+Y)"/>
                    
                    <Button Content="Экспорт" Background="#0078D4" Foreground="White" 
                            Padding="12,4" Height="28"
                            VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                    
                    <Border Classes="DarkSeparator" Width="1" Height="20" Margin="4,0" 
                            VerticalAlignment="Center"/>
                    
                    <!-- Переключатель темы -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Classes="ThemeIcon" Text="🌙" FontSize="14" 
                                   VerticalAlignment="Center" Margin="0,0,0,2"/>
                        
                        <Slider x:Name="ThemeSlider" Width="80" Height="50" Minimum="0" Maximum="1" Value="0" 
                                VerticalAlignment="Center"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                ToolTip.Tip="Переключение темы: 0 — тёмная, 1 — светлая"
                                ValueChanged="ThemeSlider_ValueChanged"
                                Margin="0,0,8,0"/>
                        
                        <TextBlock Classes="ThemeIcon" Text="☀️" FontSize="14" 
                                   VerticalAlignment="Center" Margin="0,0,0,2"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Контекстная панель параметров -->
        <Border Grid.Row="1" Grid.ColumnSpan="3" Classes="ThemePanel" Height="36" 
                 BorderThickness="0,0,0,1">
            <StackPanel Classes="ParamBackground" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0" Spacing="16">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="subtle" Text="Инструмент:" VerticalAlignment="Center" Foreground="#999"/>
                    <TextBlock x:Name="SelectedToolText" Text="Перо" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <Separator Classes="DarkSeparator" Width="1" Height="20"/>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Обводка:" VerticalAlignment="Center"/>
                    <ComboBox Width="80" SelectedIndex="1">
                        <ComboBoxItem Content="Нет"/>
                        <ComboBoxItem Content="1 пкс"/>
                        <ComboBoxItem Content="2 пкс"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Заливка:" VerticalAlignment="Center"/>
                    <Border Classes="ColorPreview" Width="28" Height="20" CornerRadius="2" BorderThickness="1"/>
                </StackPanel>
                <Slider x:Name="StrokeSlider" Width="120" Minimum="0" Maximum="100" Value="75" 
                        TickFrequency="5" IsSnapToTickEnabled="True"
                        ValueChanged="StrokeSlider_ValueChanged"/>
                <TextBlock x:Name="StrokePercentText" Text="75%" VerticalAlignment="Center" Width="40"/>
            </StackPanel>
        </Border>

        <!-- 3. Основная рабочая область -->
        <Grid Grid.Row="2" Grid.ColumnSpan="3" Classes="MainForeGround" ColumnDefinitions="Auto,*,Auto" RowDefinitions="*,Auto">

            <!-- Левая панель инструментов -->
            <Border Grid.Column="0" Classes="Panel" Width="98" Margin="4,4,0,4">
                <ScrollViewer>
                    <StackPanel Margin="4" Spacing="2">
                        <TextBlock Text="TOOLS" FontWeight="Bold" FontSize="11" Margin="6,4,6,8" Foreground="#999" HorizontalAlignment="Center"/>
                        
                        <RadioButton Classes="ToolButton" Content="🖱" Tag="Выделение" ToolTip.Tip="Выделение (V)" IsChecked="True" Checked="ToolButton_Checked" GroupName="ToolsGroup"/>
                        <RadioButton Classes="ToolButton" Content="✂️" Tag="Прямое выделение" ToolTip.Tip="Прямое выделение (A)" Checked="ToolButton_Checked" GroupName="ToolsGroup"/>
                        
                        <Separator Margin="8,4" Height="1" Background="#3F3F46"/>
                        
                        <RadioButton Classes="ToolButton" Content="⬛" Tag="Прямоугольник" ToolTip.Tip="Прямоугольник (M)" Checked="ToolButton_Checked" GroupName="ToolsGroup"/>
                        <RadioButton Classes="ToolButton" Content="⭕" Tag="Эллипс" ToolTip.Tip="Эллипс (L)" Checked="ToolButton_Checked" GroupName="ToolsGroup"/>
                        <RadioButton Classes="ToolButton" Content="▱" Tag="Многоугольник" ToolTip.Tip="Многоугольник" Checked="ToolButton_Checked" GroupName="ToolsGroup"/>
                        <RadioButton Classes="ToolButton" Content="✒️" Tag="Перо" ToolTip.Tip="Перо (P)" Checked="ToolButton_Checked" GroupName="ToolsGroup"/>
                        
                        <Separator Margin="8,4" Height="1" Background="#3F3F46"/>
                        
                        <RadioButton Classes="ToolButton" Content="🔤" Tag="Текст" ToolTip.Tip="Текст (T)" Checked="ToolButton_Checked" GroupName="ToolsGroup"/>
                        <RadioButton Classes="ToolButton" Content="✋" Tag="Рука" ToolTip.Tip="Рука (H)" Checked="ToolButton_Checked" GroupName="ToolsGroup"/>
                        <RadioButton Classes="ToolButton" Content="🔍" Tag="Масштаб" ToolTip.Tip="Масштаб (Z)" Checked="ToolButton_Checked" GroupName="ToolsGroup"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <GridSplitter Grid.Column="0" Width="4" Background="Transparent" HorizontalAlignment="Right"/>

            <!-- Холст + линейки + вкладки документов -->
            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto" Margin="0,4,0,4">
                <!-- Вкладки документов -->
                <Border Grid.Row="0" Classes="ThemePanel" Height="32" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" Spacing="2" Margin="8,0">
                        <Border Classes="DocumentTab" Padding="12,6,32,6" CornerRadius="4,4,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Безымянный.vec" FontWeight="SemiBold"/>
                                <TextBlock Text="×" Foreground="#999" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <Button Content="＋" Width="32" Height="32" Background="Transparent" Foreground="#999"/>
                    </StackPanel>
                </Border>

                <!-- Горизонтальная линейка -->
                <Border Grid.Row="1" Classes="ThemeRuler" Height="20" BorderThickness="0,1">
                    <Canvas>
                        <TextBlock Canvas.Left="40" Text="0" FontSize="10" Foreground="#888"/>
                        <TextBlock Canvas.Left="140" Text="100" FontSize="10" Foreground="#888"/>
                        <TextBlock Canvas.Left="240" Text="200" FontSize="10" Foreground="#888"/>
                        <TextBlock Canvas.Left="340" Text="300" FontSize="10" Foreground="#888"/>
                        <TextBlock Canvas.Left="440" Text="400" FontSize="10" Foreground="#888"/>
                        <TextBlock Canvas.Left="540" Text="500" FontSize="10" Foreground="#888"/>
                        <TextBlock Canvas.Left="640" Text="600" FontSize="10" Foreground="#888"/>
                        <TextBlock Canvas.Left="740" Text="700" FontSize="10" Foreground="#888"/>
                        <TextBlock Canvas.Left="840" Text="800" FontSize="10" Foreground="#888"/>
                    </Canvas>
                </Border>

                <!-- Холст с контекстным меню -->
                <Grid Grid.Row="2" ColumnDefinitions="20,*">
                    <!-- Вертикальная линейка -->
                    <Border Classes="ThemeRuler" BorderThickness="1,0">
                        <Canvas>
                            <TextBlock Canvas.Top="40" Text="0" FontSize="10" HorizontalAlignment="Center"/>
                            <TextBlock Canvas.Top="140" Text="100" FontSize="10" HorizontalAlignment="Center"/>
                            <TextBlock Canvas.Top="240" Text="200" FontSize="10" HorizontalAlignment="Center"/>
                        </Canvas>
                    </Border>

                    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Border x:Name="CanvasBorder" Width="900" Height="620"
                                Background="{StaticResource CheckerBrush}"
                                BorderBrush="#0078D4" BorderThickness="2" CornerRadius="4"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                BoxShadow="0 10 30 0 #00000088">
                            
                            <!-- Контекстное меню по правой кнопке мыши -->
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Поворот">
                                        <MenuItem x:Name="MenuRotateLeft" Header="↶ Влево (90°)" Click="RotateLeft_Click"/>
                                        <MenuItem x:Name="MenuRotateRight" Header="↷ Вправо (90°)" Click="RotateRight_Click"/>
                                        <MenuItem x:Name="MenuRotate180" Header="↻ На 180°" Click="Rotate180_Click"/>
                                        <MenuItem x:Name="MenuRotateFree" Header="Произвольно…" Click="RotateFree_Click"/>
                                    </MenuItem>
                                    
                                    <MenuItem Header="Масштаб">
                                        <MenuItem x:Name="MenuScaleUp" Header="🔍 Увеличить (150%)" Click="ScaleUp_Click"/>
                                        <MenuItem x:Name="MenuScaleDown" Header="🔎 Уменьшить (50%)" Click="ScaleDown_Click"/>
                                        <MenuItem x:Name="MenuScaleFit" Header="По размеру окна" Click="ScaleFit_Click"/>
                                        <MenuItem x:Name="MenuScaleOriginal" Header="Оригинальный размер" Click="ScaleOriginal_Click"/>
                                    </MenuItem>
                                    
                                    <MenuItem Header="Отражение">
                                        <MenuItem x:Name="MenuFlipHorizontal" Header="↔ По горизонтали" Click="FlipHorizontal_Click"/>
                                        <MenuItem x:Name="MenuFlipVertical" Header="↕ По вертикали" Click="FlipVertical_Click"/>
                                    </MenuItem>
                                    
                                    <Separator/>
                                    
                                    <MenuItem Header="Перемещение">
                                        <MenuItem x:Name="MenuMoveUp" Header="↑ Вверх (10px)" Click="MoveUp_Click"/>
                                        <MenuItem x:Name="MenuMoveDown" Header="↓ Вниз (10px)" Click="MoveDown_Click"/>
                                        <MenuItem x:Name="MenuMoveLeft" Header="← Влево (10px)" Click="MoveLeft_Click"/>
                                        <MenuItem x:Name="MenuMoveRight" Header="→ Вправо (10px)" Click="MoveRight_Click"/>
                                        <MenuItem x:Name="MenuMoveCenter" Header="По центру" Click="MoveCenter_Click"/>
                                    </MenuItem>
                                    
                                    <Separator/>
                                    
                                    <MenuItem Header="Цвет">
                                        <MenuItem x:Name="MenuColorRed" Header="🔴 Красный" Click="ColorRed_Click"/>
                                        <MenuItem x:Name="MenuColorGreen" Header="🟢 Зелёный" Click="ColorGreen_Click"/>
                                        <MenuItem x:Name="MenuColorBlue" Header="🔵 Синий" Click="ColorBlue_Click"/>
                                        <MenuItem x:Name="MenuColorYellow" Header="🟡 Жёлтый" Click="ColorYellow_Click"/>
                                        <MenuItem x:Name="MenuColorWhite" Header="⚪ Белый" Click="ColorWhite_Click"/>
                                        <MenuItem x:Name="MenuColorBlack" Header="⚫ Чёрный" Click="ColorBlack_Click"/>
                                        <MenuItem x:Name="MenuColorPicker" Header="Выбрать цвет…" Click="ColorPicker_Click"/>
                                    </MenuItem>
                                    
                                    <Separator/>
                                    
                                    <MenuItem x:Name="MenuDelete" Header="🗑️ Удалить объект" Click="DeleteObject_Click"/>
                                    <MenuItem x:Name="MenuDuplicate" Header="📋 Дублировать" Click="DuplicateObject_Click"/>
                                </ContextMenu>
                            </Border.ContextMenu>
                            
                            <Grid>
                                <Rectangle 
                                x:DataType="vm:MainWindowViewModel"
                                Fill="White"
                                IsVisible="{Binding Canvas.IsCanvasActive}"
                                Opacity="1"/>
                                <local:VectorCanvasControl 
                                    x:DataType="vm:MainWindowViewModel"
                                    x:Name="VectorCanvas"
                                   CanvasViewModel="{Binding Canvas}"
                                    ActiveFigures="{Binding Canvas.ActiveLayerFigures}"
                                   Zoom="{Binding Canvas.Zoom}"
                                   OffsetX="{Binding Canvas.OffsetX}"
                                   PointerMoved="OnCanvasPointerMoved"
                                   PointerPressed="OnCanvasPointerPressed"/>

                                <!-- Текст-подсказка (исчезает при активации) -->
    <TextBlock x:DataType="vm:MainWindowViewModel" Classes="CanvasText"
               Text="Ваш векторный холст here&#x0A;(Добавьте прямоугольник или эллипс)&#x0A;&#x0A;ПКМ для контекстного меню"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               FontSize="18" TextAlignment="Center"
               IsVisible="{Binding Canvas.IsCanvasActive, Converter={x:Static converters:InvertedBoolConverter.Instance}}"/>
    
    <!-- Подсказка при активном холсте -->
    <TextBlock x:DataType="vm:MainWindowViewModel" Classes="CanvasText"
               Text="✏️ Выберите инструмент и рисуйте"
               HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20"
               FontSize="14" Foreground="#888"
               IsVisible="{Binding Canvas.IsCanvasActive}"/>
                            </Grid>
                        </Border>
                    </ScrollViewer>
                </Grid>

                <Border Grid.Row="3" Classes="ThemeRuler" Height="20"/>
            </Grid>

            <GridSplitter Grid.Column="1" Width="4" Background="Transparent" HorizontalAlignment="Right"/>

            <!-- Правая панель -->
            <Border Grid.Column="2" Classes="Panel" Width="300" Margin="0,4,4,4">
                <TabControl Background="Transparent" TabStripPlacement="Top">
                    <TabItem Header="Свойства">
                        <ScrollViewer Padding="12">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Трансформация" FontWeight="SemiBold"/>
                                <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto">
                                    <TextBlock Text="X:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="120" Classes="PropertyInput"/>
                                    <TextBlock Text="Y:" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    <TextBox Grid.Row="0" Grid.Column="3" Text="240" Classes="PropertyInput"/>
                                </Grid>

                                <TextBlock Text="Внешний вид" FontWeight="SemiBold" Margin="0,8,0,4"/>
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Заливка"/>
                                    <Border Classes="ColorPreview" Height="28" Background="#FF4A90" CornerRadius="3" BorderBrush="#555" BorderThickness="1"/>
                                    <TextBlock Text="Обводка"/>
                                    <Border Classes="Styling" Height="28" Background="Transparent" CornerRadius="3" BorderThickness="2"/>
                                </StackPanel>

                                <Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" Value="100" 
                                        TickPlacement="BottomRight" ValueChanged="OpacitySlider_ValueChanged"/>
                                <TextBlock x:Name="OpacityText" Text="Непрозрачность: 100%" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Слои">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8" Spacing="4">
                                <Button Content="＋" Width="36" Height="28" ToolTip.Tip="Новый слой"/>
                                <Button Content="🗑️" Width="36" Height="28" ToolTip.Tip="Удалить"/>
                                <Button Content="🔒" Width="36" Height="28" ToolTip.Tip="Заблокировать"/>
                            </StackPanel>

                            <ListBox x:DataType="vm:MainWindowViewModel" ItemsSource="{Binding Canvas.Layers}" 
         SelectedItem="{Binding Canvas.ActiveLayer}" Background="Transparent" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="20,*,Auto">
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsVisible}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="История"/>
                </TabControl>
            </Border>
        </Grid>

        <!-- 4. Статус-бар -->
        <Border Grid.Row="3" Grid.ColumnSpan="3" Classes="ThemeStatusBar" Height="26" 
                BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Готово" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" Margin="0,0,20,0">
                    <TextBlock Text="X: 342  Y: 189" Foreground="#999"/>
                    <TextBlock Text="Ш: 480  В: 320" Foreground="#999"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="100%" VerticalAlignment="Center" Margin="0,0,20,0"/>
                <TextBlock Grid.Column="3" Text="RGB" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1920" d:DesignHeight="1080"
        x:Class="graphic_editor.MainWindow"
        xmlns:local="using:graphic_editor.Controls"
        xmlns:converters="using:graphic_editor.Converters"
        xmlns:vm="using:graphic_editor.ViewModels"
        xmlns:colorPicker="using:Avalonia.Controls"
        Title="INKognida — Безымянный.vec"
        Background="#1C1C1E"
        WindowState="Maximized"
        RequestedThemeVariant="Dark"
        FontFamily="Segoe UI, system-ui">
    <Window.Resources>
        <DrawingBrush x:Key="CheckerBrush" 
                      TileMode="Tile" 
                      DestinationRect="0,0,16,16">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#252526" Geometry="M0,0 L16,0 16,16 0,16 Z"/>
                    <GeometryDrawing Brush="#2F2F32" Geometry="M0,0 L8,0 8,8 0,8 Z M8,8 L16,8 16,16 8,16 Z"/>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <converters:InvertedBoolConverter x:Key="InvertedBool"/>
        <converters:IsZeroToVisibleConverter x:Key="IsZeroToVisible"/>
        <converters:ColorToBrushConverter x:Key="ColorToBrushConverter"/>
        <converters:DrawingColorConverter x:Key="DrawingColorConverter"/>
    </Window.Resources>

    <Window.Styles>
        <StyleInclude Source="Styles/GraphicEditorStyles.axaml"></StyleInclude> 
    </Window.Styles>

    <Grid Classes="MainTheme" RowDefinitions="Auto,Auto,*,Auto" ColumnDefinitions="Auto,*,Auto">
        <!-- 1. Главное меню -->
        <Border Grid.Row="0" Grid.ColumnSpan="3" Classes="ThemePanel" Height="32">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Меню слева -->
                <Menu Grid.Column="0" Background="Transparent" HorizontalAlignment="Left">
                    <MenuItem Header="_Файл">
                        <MenuItem Header="Новый…" InputGesture="Ctrl+N"/>
                        <MenuItem Header="Открыть…" InputGesture="Ctrl+O"/>
                        <MenuItem Header="Сохранить" InputGesture="Ctrl+S"/>
                        <MenuItem Header="Сохранить как…" InputGesture="Ctrl+Shift+S"/>
                        <Separator/>
                        <MenuItem Header="Выход" InputGesture="Alt+F4"/>
                    </MenuItem>
                    <MenuItem Header="_Правка">
                        <MenuItem Header="Отменить" InputGesture="Ctrl+Z"/>
                        <MenuItem Header="Повторить" InputGesture="Ctrl+Y"/>
                        <Separator/>
                        <MenuItem Header="Вырезать" InputGesture="Ctrl+X"/>
                        <MenuItem Header="Копировать" InputGesture="Ctrl+C"/>
                        <MenuItem Header="Вставить" InputGesture="Ctrl+V"/>
                    </MenuItem>
                    <MenuItem Header="_Вид">
                        <MenuItem Header="Показать линейки" IsChecked="True"/>
                        <MenuItem Header="Показать сетку" IsChecked="True"/>
                        <Separator/>
                        <MenuItem Header="Приблизить" InputGesture="Ctrl+OemPlus"/>
                        <MenuItem Header="Отдалить" InputGesture="Ctrl+OemMinus"/>
                        <MenuItem Header="Масштаб 100%" InputGesture="Ctrl+0"/>
                    </MenuItem>
                    <MenuItem Header="_Слой"/>
                    <MenuItem Header="_Объект"/>
                    <MenuItem Header="_Справка"/>
                </Menu>

                <!-- Кнопки и переключатель темы справа -->
                <StackPanel Classes="Switcher" Grid.Column="1" Orientation="Horizontal" 
                            VerticalAlignment="Center" Margin="0,0,14,0" Spacing="4">
                    
                    <!-- Кнопки с центрированием содержимого -->
                    <Button Classes="ToolActionBtn" Content="↶" Width="32" Height="24" 
                            VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                            ToolTip.Tip="Отменить (Ctrl+Z)"/>
                    
                    <Button Classes="ToolActionBtn" Content="↷" Width="32" Height="24"
                            VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                            ToolTip.Tip="Повторить (Ctrl+Y)"/>
                    
                    <Button Content="Экспорт" Background="#0078D4" Foreground="White" 
                            Padding="12,4" Height="28"
                            VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                    
                    <Border Classes="DarkSeparator" Width="1" Height="20" Margin="4,0" 
                            VerticalAlignment="Center"/>
                    
                    <!-- Переключатель темы -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Classes="ThemeIcon" Text="🌙" FontSize="14" 
                                   VerticalAlignment="Center" Margin="0,0,0,2"/>
                        
                        <Slider x:Name="ThemeSlider" Width="80" Height="50" Minimum="0" Maximum="1" Value="0" 
                                VerticalAlignment="Center"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                ToolTip.Tip="Переключение темы: 0 — тёмная, 1 — светлая"
                                ValueChanged="ThemeSlider_ValueChanged"
                                Margin="0,0,8,0"/>
                        
                        <TextBlock Classes="ThemeIcon" Text="☀️" FontSize="14" 
                                   VerticalAlignment="Center" Margin="0,0,0,2"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Контекстная панель параметров -->
        <Border Grid.Row="1" Grid.ColumnSpan="3" Classes="ThemePanel" Height="36" 
                 BorderThickness="0,0,0,1">
            <StackPanel Classes="ParamBackground" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0" Spacing="16">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="subtle" Text="Инструмент:" VerticalAlignment="Center" Foreground="#999"/>
                    <TextBlock x:Name="SelectedToolText" Text="Перо" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <Separator Classes="DarkSeparator" Width="1" Height="20"/>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Обводка:" VerticalAlignment="Center"/>
                    <ComboBox Width="80" SelectedIndex="1">
                        <ComboBoxItem Content="Нет"/>
                        <ComboBoxItem Content="1 пкс"/>
                        <ComboBoxItem Content="2 пкс"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="Заливка:" VerticalAlignment="Center"/>
                    <Border x:DataType="vm:MainWindowViewModel" Classes="ColorPreview" Width="28" Height="20" CornerRadius="2" BorderThickness="1" Background="{Binding StrokeColor.Color, Converter={StaticResource ColorToBrushConverter}}"/>
                    <Border x:DataType="vm:MainWindowViewModel" Classes="ColorPreview" Width="28" Height="20" CornerRadius="2" BorderThickness="1" Background="{Binding FillColor.Color, Converter={StaticResource ColorToBrushConverter}}"/>
                </StackPanel>
                <Slider x:DataType="vm:MainWindowViewModel" x:Name="StrokeSlider" Width="120" Minimum="0" Maximum="100" Value="{Binding StrokeWidth, Mode=TwoWay}"  
                        TickFrequency="5" IsSnapToTickEnabled="True"
                        ValueChanged="StrokeSlider_ValueChanged"/>
                <TextBlock x:Name="StrokePercentText" Text="75%" VerticalAlignment="Center" Width="40"/>
            </StackPanel>
        </Border>

        <!-- 3. Основная рабочая область -->
        <Grid Grid.Row="2" Grid.ColumnSpan="3" Classes="MainForeGround" ColumnDefinitions="Auto,*,Auto" RowDefinitions="*,Auto">

            <!-- Левая панель инструментов -->
            <Border Grid.Column="0" Classes="Panel" Width="98" Margin="4,4,0,4">
                <ScrollViewer>
                    <StackPanel Margin="4" Spacing="2">
                        <TextBlock Text="TOOLS" FontWeight="Bold" FontSize="11" Margin="6,4,6,8" Foreground="#999" HorizontalAlignment="Center"/>
                        
                        <RadioButton Classes="ToolButton" Content="🖱" Tag="Выделение" ToolTip.Tip="Выделение (V)" IsChecked="True" Checked="ToolButton_Checked" GroupName="ToolsGroup"/>
                        <RadioButton Classes="ToolButton" Content="✂️" Tag="Прямое выделение" ToolTip.Tip="Прямое выделение (A)" Checked="ToolButton_Checked" GroupName="ToolsGroup"/>
                        
                        <Separator Margin="8,4" Height="1" Background="#3F3F46"/>
                        
                        <RadioButton Classes="ToolButton" Content="▬▬" Tag="Линия" ToolTip.Tip="Линия (L)" Checked="ToolButton_Checked" GroupName="ToolsGroup"/>
                        <RadioButton Classes="ToolButton" Content="⬛" Tag="Прямоугольник" ToolTip.Tip="Прямоугольник (M)" Checked="ToolButton_Checked" GroupName="ToolsGroup"/>
                        <RadioButton Classes="ToolButton" Content="⭕" Tag="Эллипс" ToolTip.Tip="Эллипс (E)" Checked="ToolButton_Checked" GroupName="ToolsGroup"/>
                        <RadioButton Classes="ToolButton" Content="▱" Tag="Многоугольник" ToolTip.Tip="Многоугольник" Checked="ToolButton_Checked" GroupName="ToolsGroup"/>
                        <RadioButton Classes="ToolButton" Content="✒️" Tag="Перо" ToolTip.Tip="Перо (P)" Checked="ToolButton_Checked" GroupName="ToolsGroup"/>
                        
                        <Separator Margin="8,4" Height="1" Background="#3F3F46"/>
                        
                        <RadioButton Classes="ToolButton" Content="🔤" Tag="Текст" ToolTip.Tip="Текст (T)" Checked="ToolButton_Checked" GroupName="ToolsGroup"/>
                        <RadioButton Classes="ToolButton" Content="✋" Tag="Рука" ToolTip.Tip="Рука (H)" Checked="ToolButton_Checked" GroupName="ToolsGroup"/>
                        <RadioButton Classes="ToolButton" Content="🔍" Tag="Масштаб" ToolTip.Tip="Масштаб (Z)" Checked="ToolButton_Checked" GroupName="ToolsGroup"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <GridSplitter Grid.Column="0" Width="4" Background="Transparent" HorizontalAlignment="Right"/>
            <!-- Холст + линейки + вкладки документов -->
            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto" Margin="0,4,0,4">
                <!-- Вкладки документов -->
                <Border Grid.Row="0" Classes="ThemePanel" Height="32" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" Spacing="2" Margin="8,0">
                        <Border Classes="DocumentTab" Padding="12,6,32,6" CornerRadius="4,4,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Безымянный.vec" FontWeight="SemiBold"/>
                                <TextBlock Text="×" Foreground="#999" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <Button Content="＋" Width="32" Height="32" Background="Transparent" Foreground="#999"/>
                    </StackPanel>
                </Border>

                <!-- Горизонтальная линейка -->
                <Border Grid.Row="1" Classes="ThemeRuler" Height="20" BorderThickness="0,1">
                    <Canvas>
                        <TextBlock Canvas.Left="40" Text="0" FontSize="10" Foreground="#888"/>
                        <TextBlock Canvas.Left="140" Text="100" FontSize="10" Foreground="#888"/>
                        <TextBlock Canvas.Left="240" Text="200" FontSize="10" Foreground="#888"/>
                        <TextBlock Canvas.Left="340" Text="300" FontSize="10" Foreground="#888"/>
                        <TextBlock Canvas.Left="440" Text="400" FontSize="10" Foreground="#888"/>
                        <TextBlock Canvas.Left="540" Text="500" FontSize="10" Foreground="#888"/>
                        <TextBlock Canvas.Left="640" Text="600" FontSize="10" Foreground="#888"/>
                        <TextBlock Canvas.Left="740" Text="700" FontSize="10" Foreground="#888"/>
                        <TextBlock Canvas.Left="840" Text="800" FontSize="10" Foreground="#888"/>
                    </Canvas>
                </Border>

                <!-- Холст с контекстным меню -->
                <Grid Grid.Row="2" ColumnDefinitions="20,*">
                    <!-- Вертикальная линейка -->
                    <Border Classes="ThemeRuler" BorderThickness="1,0">
                        <Canvas>
                            <TextBlock Canvas.Top="40" Text="0" FontSize="10" HorizontalAlignment="Center"/>
                            <TextBlock Canvas.Top="140" Text="100" FontSize="10" HorizontalAlignment="Center"/>
                            <TextBlock Canvas.Top="240" Text="200" FontSize="10" HorizontalAlignment="Center"/>
                        </Canvas>
                    </Border>

                    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Border x:Name="CanvasBorder" Width="900" Height="620"
                                Background="{StaticResource CheckerBrush}"
                                BorderBrush="#0078D4" BorderThickness="2" CornerRadius="4"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                BoxShadow="0 10 30 0 #00000088">
                            
                            <!-- Контекстное меню по правой кнопке мыши -->
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Поворот">
                                        <MenuItem x:Name="MenuRotateLeft" Header="↶ Влево (90°)" Click="RotateLeft_Click"/>
                                        <MenuItem x:Name="MenuRotateRight" Header="↷ Вправо (90°)" Click="RotateRight_Click"/>
                                        <MenuItem x:Name="MenuRotate180" Header="↻ На 180°" Click="Rotate180_Click"/>
                                        <MenuItem x:Name="MenuRotateFree" Header="Произвольно…" Click="RotateFree_Click"/>
                                    </MenuItem>
                                    
                                    <MenuItem Header="Масштаб">
                                        <MenuItem x:Name="MenuScaleUp" Header="🔍 Увеличить (150%)" Click="ScaleUp_Click"/>
                                        <MenuItem x:Name="MenuScaleDown" Header="🔎 Уменьшить (50%)" Click="ScaleDown_Click"/>
                                        <MenuItem x:Name="MenuScaleFit" Header="По размеру окна" Click="ScaleFit_Click"/>
                                        <MenuItem x:Name="MenuScaleOriginal" Header="Оригинальный размер" Click="ScaleOriginal_Click"/>
                                    </MenuItem>
                                    
                                    <MenuItem Header="Отражение">
                                        <MenuItem x:Name="MenuFlipHorizontal" Header="↔ По горизонтали" Click="FlipHorizontal_Click"/>
                                        <MenuItem x:Name="MenuFlipVertical" Header="↕ По вертикали" Click="FlipVertical_Click"/>
                                    </MenuItem>
                                    
                                    <Separator/>
                                    
                                    <MenuItem Header="Перемещение">
                                        <MenuItem x:Name="MenuMoveUp" Header="↑ Вверх (10px)" Click="MoveUp_Click"/>
                                        <MenuItem x:Name="MenuMoveDown" Header="↓ Вниз (10px)" Click="MoveDown_Click"/>
                                        <MenuItem x:Name="MenuMoveLeft" Header="← Влево (10px)" Click="MoveLeft_Click"/>
                                        <MenuItem x:Name="MenuMoveRight" Header="→ Вправо (10px)" Click="MoveRight_Click"/>
                                        <MenuItem x:Name="MenuMoveCenter" Header="По центру" Click="MoveCenter_Click"/>
                                    </MenuItem>
                                    
                                    <Separator/>
                                    
                                    <MenuItem Header="Цвет">
                                        <!-- Тут пока нелогично - для теста заливки и цвета линии: -->
                                        <MenuItem x:DataType="vm:MainWindowViewModel" Header="🔴 Красный" Command="{Binding Commands.SetStrokeColorCommand}" CommandParameter="{x:Static Colors.Red}"/>
                                        <MenuItem x:Name="MenuColorGreen" Header="🟢 Зелёный" Click="ColorGreen_Click"/>
                                        <MenuItem x:DataType="vm:MainWindowViewModel" Header="🔵 Синий" Command="{Binding Commands.SetFillColorCommand}" CommandParameter="{x:Static Colors.Blue}"/>
                                        <MenuItem x:Name="MenuColorYellow" Header="🟡 Жёлтый" Click="ColorYellow_Click"/>
                                        <MenuItem x:Name="MenuColorWhite" Header="⚪ Белый" Click="ColorWhite_Click"/>
                                        <MenuItem x:Name="MenuColorBlack" Header="⚫ Чёрный" Click="ColorBlack_Click"/>
                                        <MenuItem x:Name="MenuColorPicker" Header="Выбрать цвет…" Click="ColorPicker_Click"/>
                                    </MenuItem>
                                    
                                    <Separator/>
                                     <MenuItem Header="Цвет обводки">
                                        <!-- Быстрые пресеты -->
                                        <MenuItem x:DataType="vm:MainWindowViewModel" Header="🔴 Красный" 
                                                  Command="{Binding Commands.SetStrokeColorCommand}"
                                                  CommandParameter="{x:Static Colors.Red}"/>
                                        <MenuItem x:DataType="vm:MainWindowViewModel" Header="🟢 Зелёный" 
                                                  Command="{Binding Commands.SetStrokeColorCommand}"
                                                  CommandParameter="{x:Static Colors.Green}"/>
                                        <MenuItem x:DataType="vm:MainWindowViewModel" Header="🔵 Синий" 
                                                  Command="{Binding Commands.SetStrokeColorCommand}"
                                                  CommandParameter="{x:Static Colors.Blue}"/>
                                        <MenuItem x:DataType="vm:MainWindowViewModel" Header="🟡 Жёлтый" 
                                                  Command="{Binding Commands.SetStrokeColorCommand}"
                                                  CommandParameter="{x:Static Colors.Yellow}"/>
                                        <MenuItem x:DataType="vm:MainWindowViewModel" Header="⚪ Белый" 
                                                  Command="{Binding Commands.SetStrokeColorCommand}"
                                                  CommandParameter="{x:Static Colors.White}"/>
                                        <MenuItem x:DataType="vm:MainWindowViewModel" Header="⚫ Чёрный" 
                                                  Command="{Binding Commands.SetStrokeColorCommand}"
                                                  CommandParameter="{x:Static Colors.Black}"/>
                                        
                                        <Separator/>
                                        
                                        <!-- Полноценный выбор цвета -->
                                        <MenuItem Header="🎨 Выбрать цвет…">
                                            <MenuItem.HeaderTemplate>
                                                <DataTemplate>
                                                    <TextBlock x:DataType="vm:MainWindowViewModel" Text="{Binding}"/>
                                                </DataTemplate>
                                            </MenuItem.HeaderTemplate>
                                            <MenuItem.Icon>
                                                <Border x:DataType="vm:MainWindowViewModel" Width="20" Height="20" CornerRadius="2" 
                                                        Background="{Binding StrokeColor.Color, 
                                                                   Converter={StaticResource ColorToBrushConverter}}"/>
                                            </MenuItem.Icon>
                                            <colorPicker:ColorPicker x:DataType="vm:MainWindowViewModel"
                                                Color="{Binding StrokeColor.Color, 
                                                             Converter={StaticResource DrawingColorConverter},
                                                             Mode=TwoWay}"
                                                Width="200" 
                                                Margin="8"/>
                                        </MenuItem>
                                    </MenuItem>
                                    <Separator/>
                                     <MenuItem Header="Цвет заливки">
                                        <!-- Быстрые пресеты -->
                                        <MenuItem x:DataType="vm:MainWindowViewModel" Header="🔴 Красный" 
                                                  Command="{Binding Commands.SetFillColorCommand}"
                                                  CommandParameter="{x:Static Colors.Red}"/>
                                        <MenuItem x:DataType="vm:MainWindowViewModel" Header="🟢 Зелёный" 
                                                  Command="{Binding Commands.SetFillColorCommand}"
                                                  CommandParameter="{x:Static Colors.Green}"/>
                                        <MenuItem x:DataType="vm:MainWindowViewModel" Header="🔵 Синий" 
                                                  Command="{Binding Commands.SetFillColorCommand}"
                                                  CommandParameter="{x:Static Colors.Blue}"/>
                                        <MenuItem x:DataType="vm:MainWindowViewModel" Header="🟡 Жёлтый" 
                                                  Command="{Binding Commands.SetFillColorCommand}"
                                                  CommandParameter="{x:Static Colors.Yellow}"/>
                                        <MenuItem x:DataType="vm:MainWindowViewModel" Header="⚪ Белый" 
                                                  Command="{Binding Commands.SetFillColorCommand}"
                                                  CommandParameter="{x:Static Colors.White}"/>
                                        <MenuItem x:DataType="vm:MainWindowViewModel" Header="⚫ Чёрный" 
                                                  Command="{Binding Commands.SetFillColorCommand}"
                                                  CommandParameter="{x:Static Colors.Black}"/>
                                        
                                        <Separator/>
                                        <!-- Кнопка "Выбрать цвет..." -->
                                            <MenuItem x:DataType="vm:MainWindowViewModel" Header="🎨 Выбрать цвет…" 
                                                      Command="{Binding Commands.OpenFillColorPickerCommand}">
                                                <MenuItem.Icon>
                                                    <Border x:DataType="vm:MainWindowViewModel" Width="20" Height="20" CornerRadius="2" 
                                                            Background="{Binding FillColor.Color, 
                                                                       Converter={StaticResource ColorToBrushConverter}}"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                     </MenuItem>
                                    <Separator/>
                                    <MenuItem x:Name="MenuDelete" Header="🗑️ Удалить объект" Click="DeleteObject_Click"/>
                                    <MenuItem x:Name="MenuDuplicate" Header="📋 Дублировать" Click="DuplicateObject_Click"/>
                                </ContextMenu>
                            </Border.ContextMenu>

                            <Grid>
                                <!-- Popup для выбора цвета -->
                                <!-- Popup для выбора цвета заливки -->
                                <Popup x:DataType="vm:MainWindowViewModel" 
                                       x:Name="ColorPickerPopup"
                                       IsOpen="{Binding IsColorPickerOpen, Mode=TwoWay}"
                                       PlacementMode="Pointer"
                                       >
                                    <Border Background="#2D2D30" 
                                            Padding="12" 
                                            CornerRadius="4" 
                                            BorderBrush="#555" 
                                            BorderThickness="1"
                                            Width="274"     
                                            Height="380">
                                        <StackPanel>
                                            <TextBlock Text="Выбор цвета заливки" 
                                                      FontWeight="SemiBold" 
                                                      Margin="0,0,0,8"
                                                      Foreground="White"/>
                                            
                                            <TextBlock Text="{Binding FillColor.Color}" 
                                                       Foreground="White" 
                                                       Margin="0,0,0,8"
                                                       FontSize="12"/>
                                            <TextBlock Text="ColorPicker загружается..." 
                                                   Foreground="Yellow" 
                                                   Margin="0,0,0,8"/>
                                            
                                            <colorPicker:ColorPicker x:DataType="vm:MainWindowViewModel"
                                                Color="{Binding FillColor.Color, 
                                                       Converter={StaticResource DrawingColorConverter},
                                                       Mode=TwoWay}"
                                                Width="250"
                                                Height="320"
                                                Background="#1E1E1E"
                                                BorderBrush="#555"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Popup>

                                <!-- Popup для выбора цвета обводки -->
                                <Popup x:DataType="vm:MainWindowViewModel" 
                                       x:Name="StrokeColorPickerPopup"
                                       IsOpen="{Binding IsStrokeColorPickerOpen, Mode=TwoWay}"
                                       PlacementMode="Pointer"
                                       >
                                    <Border Background="#2D2D30" 
                                            Padding="12" 
                                            CornerRadius="4" 
                                            BorderBrush="#555" 
                                            BorderThickness="1"
                                            Width="274"     
                                            Height="380">
                                        <Grid RowDefinitions="Auto,Auto,*,Auto">
                                            <TextBlock Grid.Row="0"
                                                      Text="Выбор цвета обводки" 
                                                      FontWeight="SemiBold" 
                                                      Margin="0,0,0,8"
                                                      Foreground="White"/>
                                            
                                            <TextBlock x:DataType="vm:MainWindowViewModel" Text="{Binding FillColor.Color}" 
                                               Foreground="White" 
                                               Grid.Row="1"/>
                                            <colorPicker:ColorPicker x:DataType="vm:MainWindowViewModel" 
                                                        Grid.Row="2"
                                                        Color="{Binding StrokeColor.Color, 
                                                               Converter={StaticResource DrawingColorConverter},
                                                               Mode=TwoWay}"
                                                        Width="250"
                                                        Height="320"
                                                        IsVisible="True"/>
                                        </Grid>
                                    </Border>
                                </Popup>
                                
                                <Rectangle 
                                    x:DataType="vm:MainWindowViewModel"
                                    Fill="White"
                                    IsVisible="{Binding Canvas.IsCanvasActive}"
                                    Opacity="1"
                                />
                                <local:VectorCanvasControl 
                                    x:DataType="vm:MainWindowViewModel"
                                    x:Name="VectorCanvas"
                                    CanvasViewModel="{Binding Canvas}"
                                    Zoom="{Binding Canvas.Zoom}"
                                    OffsetX="{Binding Canvas.OffsetX}"
									OffsetY="{Binding Canvas.OffsetY}"
									PointerMoved="OnCanvasPointerMoved"
    								PointerPressed="OnCanvasPointerPressed"
    								PointerReleased="OnCanvasPointerReleased"
                                />

                                <!-- Текст-подсказка (исчезает при активации) -->
                                <TextBlock x:DataType="vm:MainWindowViewModel" Classes="CanvasText"
                                           Text="Ваш векторный холст here&#x0A;(Добавьте прямоугольник или эллипс)&#x0A;&#x0A;ПКМ для контекстного меню"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="18" TextAlignment="Center"
                                           IsVisible="{Binding Canvas.IsCanvasActive, Converter={x:Static converters:InvertedBoolConverter.Instance}}"
                                />
                                
                                <!-- Подсказка при активном холсте -->
                                <TextBlock x:DataType="vm:MainWindowViewModel" Classes="CanvasText"
                                           Text="✏️ Выберите инструмент и рисуйте"
                                           HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20"
                                           FontSize="14" Foreground="#888"
                                           IsVisible="{Binding Canvas.IsCanvasActive}"
                                />
                            </Grid>
                        </Border>
                    </ScrollViewer>
                </Grid>

                <Border Grid.Row="3" Classes="ThemeRuler" Height="20"/>
            </Grid>

            <GridSplitter Grid.Column="1" Width="4" Background="Transparent" HorizontalAlignment="Right"/>

            <!-- Правая панель -->
            <Border Grid.Column="2" Classes="Panel" Width="300" Margin="0,4,4,4">
                <TabControl Background="Transparent" TabStripPlacement="Top">
                    <TabItem Header="Свойства">
                        <ScrollViewer Padding="12">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Трансформация" FontWeight="SemiBold"/>
                                <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto">
                                    <TextBlock Text="X:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="120" Classes="PropertyInput"/>
                                    <TextBlock Text="Y:" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    <TextBox Grid.Row="0" Grid.Column="3" Text="240" Classes="PropertyInput"/>
                                </Grid>

                                <TextBlock Text="Внешний вид" FontWeight="SemiBold" Margin="0,8,0,4"/>
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Заливка"/>
                                    <Border Classes="ColorPreview" Height="28" Background="#FF4A90" CornerRadius="3" BorderBrush="#555" BorderThickness="1"/>
                                    <TextBlock Text="Обводка"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Border x:DataType="vm:MainWindowViewModel" Classes="ColorPreview" Height="28" Width="28"
                                            Background="{Binding StrokeColor.Color, Converter={StaticResource ColorToBrushConverter}}"
                                            CornerRadius="3" BorderBrush="#555" BorderThickness="1"/>
                                    <!-- Превью толщины -->
                                    <Border x:DataType="vm:MainWindowViewModel" Background="#555" CornerRadius="2" 
                                            Height="28" Width="{Binding StrokeWidth}" 
                                            MinWidth="1" MaxWidth="20"
                                            HorizontalAlignment="Left"/>
                                    <TextBlock x:DataType="vm:MainWindowViewModel" Text="{Binding StrokeWidth, StringFormat='{}{0}px'}" 
                                              VerticalAlignment="Center" Foreground="#999"/>
                                    </StackPanel>
                                </StackPanel>

                                <Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" Value="100" 
                                        TickPlacement="BottomRight" ValueChanged="OpacitySlider_ValueChanged"
                                />
                                <TextBlock x:Name="OpacityText" Text="Непрозрачность: 100%" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="Слои">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8" Spacing="4">
                                <Button 
                                    x:DataType="vm:MainWindowViewModel"
                                    Content="📄 ＋" 
                                    Command="{Binding Commands.CreateNewLayer}"
                                    ToolTip.Tip="Создать новый слой для рисования"
                                    Width="36" 
                                    Height="28"
                                    HorizontalAlignment="Stretch"/>
                                <Button Content="🗑️" Width="36" Height="28" ToolTip.Tip="Удалить"/>
                                <Button Content="🔒" Width="36" Height="28" ToolTip.Tip="Заблокировать"/>
                            </StackPanel>

                            <ListBox 
                                x:DataType="vm:MainWindowViewModel" 
                                ItemsSource="{Binding Canvas.Layers}" 
                                SelectedItem="{Binding Canvas.ActiveLayer}" 
                                Background="Transparent" 
                                BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="20,*,Auto">
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsVisible}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="История"/>
                </TabControl>
            </Border>
        </Grid>

        <!-- 4. Статус-бар -->
        <Border 
            Grid.Row="3" 
            Grid.ColumnSpan="3" 
            Classes="ThemeStatusBar" 
            Height="26" 
            BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Готово" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" Margin="0,0,20,0">
                    <TextBlock Text="X: 342  Y: 189" Foreground="#999"/>
                    <TextBlock Text="Ш: 480  В: 320" Foreground="#999"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="100%" VerticalAlignment="Center" Margin="0,0,20,0"/>
                <TextBlock Grid.Column="3" Text="RGB" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
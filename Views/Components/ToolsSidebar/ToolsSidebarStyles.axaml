<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="RadioButton.ToolButton">
        <Setter Property="Width" Value="50"/>
        <Setter Property="Height" Value="50"/>
        <Setter Property="Margin" Value="3"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="22"/>
    </Style>
    <Style Selector="RadioButton.ToolButton:pointerover">
        <Setter Property="Background" Value="#3C3C3E"/>
    </Style>
    <Style Selector="RadioButton.ToolButton:checked">
        <Setter Property="Background" Value="#0078D4"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Window[RequestedThemeVariant=Light] RadioButton.ToolButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#333333"/>
    </Style>
    <Style Selector="Window[RequestedThemeVariant=Light] RadioButton.ToolButton:pointerover">
        <Setter Property="Background" Value="#E5E5E5"/>
    </Style>
    <Style Selector="Window[RequestedThemeVariant=Light] RadioButton.ToolButton:checked">
        <Setter Property="Background" Value="#0078D4"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
</Styles>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="graphic_editor.Views.Components.ToolsSidebar">
    <UserControl.Styles>
        <StyleInclude Source="ToolsSidebarStyles.axaml"/>
    </UserControl.Styles>

    <Border Classes="Panel" Width="98" Margin="4,4,0,4">
        <ScrollViewer>
            <StackPanel Margin="4" Spacing="2">
                <TextBlock Text="TOOLS" FontWeight="Bold" FontSize="11" Margin="6,4,6,8" Foreground="#999" HorizontalAlignment="Center"/>
                <RadioButton Classes="ToolButton" Content="🖱" Tag="Выделение" ToolTip.Tip="Выделение (V)&#x0A;Ctrl+Click — мульти-выделение" IsChecked="True" Checked="OnToolButtonChecked" GroupName="ToolsGroup"/>
                <RadioButton Classes="ToolButton" Content="✂️" Tag="Прямое выделение" ToolTip.Tip="Прямое выделение (A)" Checked="OnToolButtonChecked" GroupName="ToolsGroup"/>
                <RadioButton Classes="ToolButton" Content="🧽" Tag="Ластик" ToolTip.Tip="Ластик (E)&#x0A;Удаляет фигуру при клике" Checked="OnToolButtonChecked" GroupName="ToolsGroup"/>
                <Separator Margin="8,4" Height="1" Background="#3F3F46"/>
                <RadioButton Classes="ToolButton" Content="───" Tag="Линия" ToolTip.Tip="Линия (L)" Checked="OnToolButtonChecked" GroupName="ToolsGroup"/>
                <RadioButton Classes="ToolButton" Content="▭" Tag="Прямоугольник" ToolTip.Tip="Прямоугольник (Rect)" Checked="OnToolButtonChecked" GroupName="ToolsGroup"/>
                <RadioButton Classes="ToolButton" Content="⬛" Tag="Квадрат" ToolTip.Tip="Квадрат (Sq)" Checked="OnToolButtonChecked" GroupName="ToolsGroup"/>
                <RadioButton Classes="ToolButton" Content="🕳️" Tag="Эллипс" ToolTip.Tip="Эллипс (E)" Checked="OnToolButtonChecked" GroupName="ToolsGroup"/>
                <RadioButton Classes="ToolButton" Content="⭕" Tag="Круг" ToolTip.Tip="Круг (Cir)" Checked="OnToolButtonChecked" GroupName="ToolsGroup"/>
                <RadioButton Classes="ToolButton" Content="✒️" Tag="Перо" ToolTip.Tip="Перо (P)" Checked="OnToolButtonChecked" GroupName="ToolsGroup"/>
                <RadioButton Classes="ToolButton" Content="⬟" Tag="Пятиугольник" ToolTip.Tip="Пятиугольник" Checked="OnToolButtonChecked" GroupName="ToolsGroup"/>
                <RadioButton Classes="ToolButton" Content="⬢" Tag="Шестиугольник" ToolTip.Tip="Шестиугольник" Checked="OnToolButtonChecked" GroupName="ToolsGroup"/>
                <RadioButton Classes="ToolButton" Content="⯃" Tag="Семиугольник" ToolTip.Tip="Семиугольник" Checked="OnToolButtonChecked" GroupName="ToolsGroup"/>
                <RadioButton Classes="ToolButton" Content="🛑" Tag="Восьмиугольник" ToolTip.Tip="Восьмиугольник" Checked="OnToolButtonChecked" GroupName="ToolsGroup"/>
                <RadioButton Classes="ToolButton" Content="★" Tag="Пентаграмма" ToolTip.Tip="Пентаграмма" Checked="OnToolButtonChecked" GroupName="ToolsGroup"/>
                <RadioButton Classes="ToolButton" Content="△" Tag="Треугольник" ToolTip.Tip="Треугольник" Checked="OnToolButtonChecked" GroupName="ToolsGroup"/>
                <RadioButton Classes="ToolButton" Content="◆" Tag="Ромб" ToolTip.Tip="Ромб (Rh)" Checked="OnToolButtonChecked" GroupName="ToolsGroup"/>
                <Separator Margin="8,4" Height="1" Background="#3F3F46"/>
                <RadioButton Classes="ToolButton" Content="🔤" Tag="Текст" ToolTip.Tip="Текст (T)" Checked="OnToolButtonChecked" GroupName="ToolsGroup"/>
                <RadioButton Classes="ToolButton" Content="✋" Tag="Рука" ToolTip.Tip="Рука (H)" Checked="OnToolButtonChecked" GroupName="ToolsGroup"/>
                <RadioButton Classes="ToolButton" Content="🔍" Tag="Масштаб" ToolTip.Tip="Масштаб (Z)" Checked="OnToolButtonChecked" GroupName="ToolsGroup"/>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
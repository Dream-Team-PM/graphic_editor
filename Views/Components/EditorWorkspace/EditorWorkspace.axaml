<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:graphic_editor.Controls"
             xmlns:converters="using:graphic_editor.Converters"
             xmlns:vm="using:graphic_editor.ViewModels"
             x:Class="graphic_editor.Views.Components.EditorWorkspace"
             x:DataType="vm:MainWindowViewModel">
    <UserControl.Styles>
        <StyleInclude Source="EditorWorkspaceStyles.axaml"/>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="0,4,0,4">
        <Border Grid.Row="0" Classes="ThemePanel" Height="32" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="2" Margin="8,0">
                <Border Classes="DocumentTab" Padding="12,6,32,6" CornerRadius="4,4,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Безымянный.vec" FontWeight="SemiBold"/>
                        <TextBlock Text="×" Foreground="#999" Margin="8,0,0,0"/>
                    </StackPanel>
                </Border>
                <Button Content="+" Width="32" Height="32" Background="Transparent" Foreground="#999"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="1" Classes="ThemeRuler" Height="20" BorderThickness="0,1">
            <Canvas>
                <TextBlock Canvas.Left="40" Text="0" FontSize="10" Foreground="#888"/>
                <TextBlock Canvas.Left="140" Text="100" FontSize="10" Foreground="#888"/>
                <TextBlock Canvas.Left="240" Text="200" FontSize="10" Foreground="#888"/>
            </Canvas>
        </Border>
        <Grid Grid.Row="2" ColumnDefinitions="20,*">
            <Border Classes="ThemeRuler" BorderThickness="1,0">
                <Canvas>
                    <TextBlock Canvas.Top="40" Text="0" FontSize="10" HorizontalAlignment="Center"/>
                    <TextBlock Canvas.Top="140" Text="100" FontSize="10" HorizontalAlignment="Center"/>
                    <TextBlock Canvas.Top="240" Text="200" FontSize="10" HorizontalAlignment="Center"/>
                </Canvas>
            </Border>
            <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Border x:Name="CanvasBorder" Width="900" Height="620" Background="{StaticResource CheckerBrush}" BorderBrush="#0078D4" BorderThickness="2" CornerRadius="4" HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 10 30 0 #00000088">
                    <Border.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Поворот">
                                <MenuItem Header="↶ Влево (90°)" Command="{Binding Commands.RotateLeft}"/>
                                <MenuItem Header="↷ Вправо (90°)" Command="{Binding Commands.RotateRight}"/>
                                <MenuItem Header="↻ На 180°" Command="{Binding Commands.RotateFull}"/>
                            </MenuItem>
                            <MenuItem Header="Масштаб">
                                <MenuItem Header="Увеличить (150%)" Command="{Binding Commands.ZoomIn}"/>
                                <MenuItem Header="Уменьшить (50%)" Command="{Binding Commands.ZoomOut}"/>
                                <MenuItem Header="По размеру окна" Command="{Binding Commands.ZoomFit}"/>
                            </MenuItem>
                            <MenuItem Header="Отражение">
                                <MenuItem Header="↔ По горизонтали" Command="{Binding Commands.FlipHorizontal}"/>
                                <MenuItem Header="↕ По вертикали" Command="{Binding Commands.FlipVertical}"/>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="Перемещение">
                                <MenuItem Header="↑ Вверх (10px)" Command="{Binding Commands.MoveUp}"/>
                                <MenuItem Header="↓ Вниз (10px)" Command="{Binding Commands.MoveDown}"/>
                                <MenuItem Header="← Влево (10px)" Command="{Binding Commands.MoveLeft}"/>
                                <MenuItem Header="→ Вправо (10px)" Command="{Binding Commands.MoveRight}"/>
                            </MenuItem>
                            <MenuItem Header="Группа">
                                <MenuItem Header="Сгруппировать" Command="{Binding Commands.GroupSelected}" InputGesture="Ctrl+G"/>
                                <MenuItem Header="Разгруппировать" Command="{Binding Commands.UngroupSelected}" InputGesture="Ctrl+Shift+G"/>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="Цвет заливки">
                                <MenuItem Command="{Binding Commands.SetFillColorCommand}" CommandParameter="{x:Static Colors.Red}">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="🔴" FontFamily="Segoe UI Emoji, Segoe UI Symbol" FontSize="14"/>
                                            <TextBlock Text="Красный"/>
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Command="{Binding Commands.SetFillColorCommand}" CommandParameter="{x:Static Colors.Green}">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="🟢" FontFamily="Segoe UI Emoji, Segoe UI Symbol" FontSize="14"/>
                                            <TextBlock Text="Зелёный"/>
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Command="{Binding Commands.SetFillColorCommand}" CommandParameter="{x:Static Colors.Blue}">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="🔵" FontFamily="Segoe UI Emoji, Segoe UI Symbol" FontSize="14"/>
                                            <TextBlock Text="Синий"/>
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Command="{Binding Commands.SetFillColorCommand}" CommandParameter="{x:Static Colors.Yellow}">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="🟡" FontFamily="Segoe UI Emoji, Segoe UI Symbol" FontSize="14"/>
                                            <TextBlock Text="Жёлтый"/>
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Выбрать цвет..." Command="{Binding Commands.OpenFillColorPickerCommand}">
                                    <MenuItem.Icon>
                                        <Border Width="20" Height="20" CornerRadius="2" Background="{Binding FillColor.Color, Converter={StaticResource ColorToBrushConverter}}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="Удалить объект" Command="{Binding Commands.DeleteSelected}"/>
                            <MenuItem Header="Дублировать" Command="{Binding Commands.DuplicateSelected}"/>
                        </ContextMenu>
                    </Border.ContextMenu>
                    <Grid>
                        <Rectangle Fill="White" IsVisible="{Binding Canvas.IsCanvasActive}" Opacity="1"/>
                        <local:VectorCanvasControl x:Name="VectorCanvas" CanvasViewModel="{Binding Canvas}" Zoom="{Binding Canvas.Zoom}" OffsetX="{Binding Canvas.OffsetX}" OffsetY="{Binding Canvas.OffsetY}"/>
                        <Canvas IsHitTestVisible="False">
                            <Rectangle Stroke="#0078D4" StrokeThickness="1" StrokeDashArray="4,2" Fill="#0078D420" Canvas.Left="{Binding SelectionStart.X}" Canvas.Top="{Binding SelectionStart.Y}" IsVisible="{Binding IsSelectingArea}">
                                <Rectangle.Width>
                                    <MultiBinding Converter="{StaticResource MathSubtract}">
                                        <Binding Path="SelectionEnd.X"/>
                                        <Binding Path="SelectionStart.X"/>
                                    </MultiBinding>
                                </Rectangle.Width>
                                <Rectangle.Height>
                                    <MultiBinding Converter="{StaticResource MathSubtract}">
                                        <Binding Path="SelectionEnd.Y"/>
                                        <Binding Path="SelectionStart.Y"/>
                                    </MultiBinding>
                                </Rectangle.Height>
                            </Rectangle>
                        </Canvas>
                        <TextBlock Classes="CanvasText" Text="Ваш векторный холст here&#x0A;(Добавьте прямоугольник или эллипс)&#x0A;&#x0A;ПКМ для контекстного меню" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" TextAlignment="Center" IsVisible="{Binding Canvas.IsCanvasActive, Converter={x:Static converters:InvertedBoolConverter.Instance}}"/>
                        <TextBlock Classes="CanvasText" Text="Выберите инструмент и рисуйте" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20" FontSize="14" Foreground="#888" IsVisible="{Binding Canvas.IsCanvasActive}"/>
                    </Grid>
                </Border>
            </ScrollViewer>
        </Grid>
        <Border Grid.Row="3" Classes="ThemeRuler" Height="20"/>
    </Grid>
</UserControl>

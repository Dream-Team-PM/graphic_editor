<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:graphic_editor.Controls"
             xmlns:converters="using:graphic_editor.Converters"
             xmlns:vm="using:graphic_editor.ViewModels"
             x:Class="graphic_editor.Views.Components.EditorWorkspace"
             x:DataType="vm:MainWindowViewModel">

    <UserControl.Styles>
        <StyleInclude Source="EditorWorkspaceStyles.axaml"/>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="0,4,0,4">
        
        <!-- Вкладки документов -->
        <Border Grid.Row="0" Classes="ThemePanel" Height="32" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="2" Margin="8,0">
                <Border Classes="DocumentTab" Padding="12,6,32,6" CornerRadius="4,4,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Безымянный.vec" FontWeight="SemiBold"/>
                        <TextBlock Text="×" Foreground="#999" Margin="8,0,0,0"/>
                    </StackPanel>
                </Border>
                <Button x:Name="NewDocumentButton" Content="＋" Width="32" Height="32" 
                        Background="Transparent" Foreground="#999"/>
            </StackPanel>
        </Border>

        <!-- Горизонтальная линейка (полная версия) -->
        <Border Grid.Row="1" Classes="ThemeRuler" Height="20" BorderThickness="0,1">
            <Canvas>
                <TextBlock Canvas.Left="40" Text="0" FontSize="10" Foreground="#888"/>
                <TextBlock Canvas.Left="140" Text="100" FontSize="10" Foreground="#888"/>
                <TextBlock Canvas.Left="240" Text="200" FontSize="10" Foreground="#888"/>
                <TextBlock Canvas.Left="340" Text="300" FontSize="10" Foreground="#888"/>
                <TextBlock Canvas.Left="440" Text="400" FontSize="10" Foreground="#888"/>
                <TextBlock Canvas.Left="540" Text="500" FontSize="10" Foreground="#888"/>
                <TextBlock Canvas.Left="640" Text="600" FontSize="10" Foreground="#888"/>
                <TextBlock Canvas.Left="740" Text="700" FontSize="10" Foreground="#888"/>
                <TextBlock Canvas.Left="840" Text="800" FontSize="10" Foreground="#888"/>
            </Canvas>
        </Border>

        <!-- Холст с контекстным меню -->
        <Grid Grid.Row="2" ColumnDefinitions="20,*">
            
            <!-- Вертикальная линейка -->
            <Border Classes="ThemeRuler" BorderThickness="1,0">
                <Canvas>
                    <TextBlock Canvas.Top="40" Text="0" FontSize="10" HorizontalAlignment="Center"/>
                    <TextBlock Canvas.Top="140" Text="100" FontSize="10" HorizontalAlignment="Center"/>
                    <TextBlock Canvas.Top="240" Text="200" FontSize="10" HorizontalAlignment="Center"/>
                </Canvas>
            </Border>

            <ScrollViewer Grid.Column="1" x:Name="CanvasScrollViewer" 
                          HorizontalScrollBarVisibility="Auto" 
                          VerticalScrollBarVisibility="Auto">
                <Border x:Name="CanvasBorder" Width="900" Height="620" 
                        Background="{StaticResource CheckerBrush}" 
                        BorderBrush="#0078D4" BorderThickness="2" CornerRadius="4" 
                        HorizontalAlignment="Center" VerticalAlignment="Center" 
                        BoxShadow="0 10 30 0 #00000088">
                    
                    <!-- Контекстное меню (полная версия) -->
                    <Border.ContextMenu>
                        <ContextMenu>
                            <!-- Поворот -->
                            <MenuItem Header="Поворот">
                                <MenuItem Header="↶ Влево (90°)" Command="{Binding Commands.RotateLeft}"/>
                                <MenuItem Header="↷ Вправо (90°)" Command="{Binding Commands.RotateRight}"/>
                                <MenuItem Header="↻ На 180°" Command="{Binding Commands.RotateFull}"/>
                            </MenuItem>
                            
                            <!-- Масштаб -->
                            <MenuItem Header="Масштаб">
                                <MenuItem Header="🔍 Увеличить (150%)" Command="{Binding Commands.ZoomIn}"/>
                                <MenuItem Header="🔎 Уменьшить (50%)" Command="{Binding Commands.ZoomOut}"/>
                                <MenuItem Header="По размеру окна" Command="{Binding Commands.ZoomFit}"/>
                                <MenuItem Header="Оригинальный размер" Command="{Binding Commands.ZoomFit}"/>
                            </MenuItem>
                            
                            <!-- Отражение -->
                            <MenuItem Header="Отражение">
                                <MenuItem Header="↔ По горизонтали" Command="{Binding Commands.FlipHorizontal}"/>
                                <MenuItem Header="↕ По вертикали" Command="{Binding Commands.FlipVertical}"/>
                            </MenuItem>
                            
                            <Separator/>
                            
                            <!-- Перемещение -->
                            <MenuItem Header="Перемещение">
                                <MenuItem Header="↑ Вверх (10px)" Command="{Binding Commands.MoveUp}"/>
                                <MenuItem Header="↓ Вниз (10px)" Command="{Binding Commands.MoveDown}"/>
                                <MenuItem Header="← Влево (10px)" Command="{Binding Commands.MoveLeft}"/>
                                <MenuItem Header="→ Вправо (10px)" Command="{Binding Commands.MoveRight}"/>
                            </MenuItem>

                            <!-- Группа -->
                            <MenuItem Header="Группа">
                                <MenuItem Header="📦 Сгруппировать" Command="{Binding Commands.GroupSelected}" InputGesture="Ctrl+G"/>
                                <MenuItem Header="📦 Разгруппировать" Command="{Binding Commands.UngroupSelected}" InputGesture="Ctrl+Shift+G"/>
                            </MenuItem>
                            
                            <Separator/>
                            
                            <!-- ✅ Цвет обводки (полная версия с 6 пресетами) -->
                            <MenuItem Header="Цвет обводки">
                                <MenuItem Command="{Binding Commands.SetStrokeColorCommand}" CommandParameter="{x:Static Colors.Red}">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="🔴" FontFamily="Segoe UI Emoji" FontSize="14"/>
                                            <TextBlock Text="Красный"/>
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Command="{Binding Commands.SetStrokeColorCommand}" CommandParameter="{x:Static Colors.Green}">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="🟢" FontFamily="Segoe UI Emoji" FontSize="14"/>
                                            <TextBlock Text="Зелёный"/>
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Command="{Binding Commands.SetStrokeColorCommand}" CommandParameter="{x:Static Colors.Blue}">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="🔵" FontFamily="Segoe UI Emoji" FontSize="14"/>
                                            <TextBlock Text="Синий"/>
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Command="{Binding Commands.SetStrokeColorCommand}" CommandParameter="{x:Static Colors.Yellow}">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="🟡" FontFamily="Segoe UI Emoji" FontSize="14"/>
                                            <TextBlock Text="Жёлтый"/>
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Command="{Binding Commands.SetStrokeColorCommand}" CommandParameter="{x:Static Colors.White}">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="⚪" FontFamily="Segoe UI Emoji" FontSize="14"/>
                                            <TextBlock Text="Белый"/>
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Command="{Binding Commands.SetStrokeColorCommand}" CommandParameter="{x:Static Colors.Black}">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="⚫" FontFamily="Segoe UI Emoji" FontSize="14"/>
                                            <TextBlock Text="Чёрный"/>
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="🎨 Выбрать цвет…" Command="{Binding Commands.OpenStrokeColorPickerCommand}">
                                    <MenuItem.Icon>
                                        <Border Width="20" Height="20" CornerRadius="2" 
                                                Background="{Binding StrokeColor.Color, Converter={StaticResource ColorToBrushConverter}}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuItem>
                            
                            <!-- ✅ Цвет заливки (полная версия с 6 пресетами) -->
                            <MenuItem Header="Цвет заливки">
                                <MenuItem Command="{Binding Commands.SetFillColorCommand}" CommandParameter="{x:Static Colors.Red}">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="🔴" FontFamily="Segoe UI Emoji" FontSize="14"/>
                                            <TextBlock Text="Красный"/>
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Command="{Binding Commands.SetFillColorCommand}" CommandParameter="{x:Static Colors.Green}">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="🟢" FontFamily="Segoe UI Emoji" FontSize="14"/>
                                            <TextBlock Text="Зелёный"/>
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Command="{Binding Commands.SetFillColorCommand}" CommandParameter="{x:Static Colors.Blue}">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="🔵" FontFamily="Segoe UI Emoji" FontSize="14"/>
                                            <TextBlock Text="Синий"/>
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Command="{Binding Commands.SetFillColorCommand}" CommandParameter="{x:Static Colors.Yellow}">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="🟡" FontFamily="Segoe UI Emoji" FontSize="14"/>
                                            <TextBlock Text="Жёлтый"/>
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Command="{Binding Commands.SetFillColorCommand}" CommandParameter="{x:Static Colors.White}">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="⚪" FontFamily="Segoe UI Emoji" FontSize="14"/>
                                            <TextBlock Text="Белый"/>
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                                <MenuItem Command="{Binding Commands.SetFillColorCommand}" CommandParameter="{x:Static Colors.Black}">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="⚫" FontFamily="Segoe UI Emoji" FontSize="14"/>
                                            <TextBlock Text="Чёрный"/>
                                        </StackPanel>
                                    </MenuItem.Header>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="🎨 Выбрать цвет…" Command="{Binding Commands.OpenFillColorPickerCommand}">
                                    <MenuItem.Icon>
                                        <Border Width="20" Height="20" CornerRadius="2" 
                                                Background="{Binding FillColor.Color, Converter={StaticResource ColorToBrushConverter}}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </MenuItem>
                            
                            <Separator/>
                            
                            <MenuItem Header="🗑️ Удалить объект" Command="{Binding Commands.DeleteSelected}"/>
                            <MenuItem Header="📋 Дублировать" Command="{Binding Commands.DuplicateSelected}"/>
                        </ContextMenu>
                    </Border.ContextMenu>

                    <Grid>
                        <!-- Фон холста -->
                        <Rectangle Fill="White" IsVisible="{Binding Canvas.IsCanvasActive}" Opacity="1"/>
                        
                        <!-- ✅ VectorCanvasControl без обработчиков в XAML (подписка в code-behind) -->
                        <local:VectorCanvasControl x:Name="VectorCanvas" 
                                                   CanvasViewModel="{Binding Canvas}" 
                                                   Zoom="{Binding Canvas.Zoom}" 
                                                   OffsetX="{Binding Canvas.OffsetX}" 
                                                   OffsetY="{Binding Canvas.OffsetY}"/>
                        
                        <!-- Выделение области с MultiBinding -->
                        <Canvas IsHitTestVisible="False">
                            <Rectangle Stroke="#0078D4" StrokeThickness="1" 
                                       StrokeDashArray="4,2" Fill="#0078D420" 
                                       Canvas.Left="{Binding SelectionStart.X}" 
                                       Canvas.Top="{Binding SelectionStart.Y}" 
                                       IsVisible="{Binding IsSelectingArea}">
                                <Rectangle.Width>
                                    <MultiBinding Converter="{StaticResource MathSubtract}">
                                        <Binding Path="SelectionEnd.X"/>
                                        <Binding Path="SelectionStart.X"/>
                                    </MultiBinding>
                                </Rectangle.Width>
                                <Rectangle.Height>
                                    <MultiBinding Converter="{StaticResource MathSubtract}">
                                        <Binding Path="SelectionEnd.Y"/>
                                        <Binding Path="SelectionStart.Y"/>
                                    </MultiBinding>
                                </Rectangle.Height>
                            </Rectangle>
                        </Canvas>

                        <!-- Подсказка при неактивном холсте -->
                        <TextBlock Classes="CanvasText" 
                                   Text="Ваш векторный холст here&#x0A;(Добавьте прямоугольник или эллипс)&#x0A;&#x0A;ПКМ для контекстного меню" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center" 
                                   FontSize="18" TextAlignment="Center" 
                                   IsVisible="{Binding Canvas.IsCanvasActive, Converter={x:Static converters:InvertedBoolConverter.Instance}}"/>
                        
                        <!-- Подсказка при активном холсте -->
                        <TextBlock Classes="CanvasText" 
                                   Text="✏️ Выберите инструмент и рисуйте" 
                                   HorizontalAlignment="Center" VerticalAlignment="Bottom" 
                                   Margin="0,0,0,20" FontSize="14" Foreground="#888" 
                                   IsVisible="{Binding Canvas.IsCanvasActive}"/>
                    </Grid>
                </Border>
            </ScrollViewer>
        </Grid>

        <!-- Нижняя линейка -->
        <Border Grid.Row="3" Classes="ThemeRuler" Height="20"/>
    </Grid>
</UserControl>
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="Border.DocumentTab">
        <Setter Property="Background" Value="#252526"/>
    </Style>
    <Style Selector="Window[RequestedThemeVariant=Light] Border.DocumentTab">
        <Setter Property="Background" Value="#BCBCBC"/>
    </Style>
    <Style Selector="Window[RequestedThemeVariant=Dark] Border.DocumentTab">
        <Setter Property="Background" Value="#252526"/>
    </Style>
    <Style Selector="Window[RequestedThemeVariant=Light] Border.DocumentTab TextBlock">
        <Setter Property="Foreground" Value="#333333"/>
    </Style>
    <Style Selector="TextBlock.CanvasText">
        <Setter Property="Foreground" Value="#888888"/>
    </Style>
    <Style Selector="Window[RequestedThemeVariant=Light] TextBlock.CanvasText">
        <Setter Property="Foreground" Value="#666666"/>
    </Style>
    <Style Selector="Window[RequestedThemeVariant=Light] Border#CanvasBorder">
        <Setter Property="Background">
            <Setter.Value>
                <DrawingBrush TileMode="Tile" DestinationRect="0,0,16,16">
                    <DrawingBrush.Drawing>
                        <DrawingGroup>
                            <GeometryDrawing Brush="#FFFFFF" Geometry="M0,0 L16,0 16,16 0,16 Z"/>
                            <GeometryDrawing Brush="#F0F0F0" Geometry="M0,0 L8,0 8,8 0,8 Z M8,8 L16,8 16,16 8,16 Z"/>
                        </DrawingGroup>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush" Value="#0078D4"/>
    </Style>
</Styles>

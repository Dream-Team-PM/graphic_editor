<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:graphic_editor.ViewModels"
             x:Class="graphic_editor.Views.Components.PropertiesSidebar"
             x:DataType="vm:MainWindowViewModel">
    <UserControl.Styles>
        <StyleInclude Source="PropertiesSidebarStyles.axaml"/>
    </UserControl.Styles>

    <Border Classes="Panel" Width="300" Margin="0,4,4,4">
        <TabControl Background="Transparent" TabStripPlacement="Top">
            <TabItem Header="Свойства">
                <ScrollViewer Padding="12">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Трансформация" FontWeight="SemiBold"/>
                        <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto">
                            <TextBlock Text="X:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="120" Classes="PropertyInput"/>
                            <TextBlock Text="Y:" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            <TextBox Grid.Row="0" Grid.Column="3" Text="240" Classes="PropertyInput"/>
                        </Grid>
                        <TextBlock Text="Внешний вид" FontWeight="SemiBold" Margin="0,8,0,4"/>
                        <StackPanel Spacing="8">
                            <TextBlock Text="Заливка"/>
                            <Border Classes="ColorPreview" Height="28" Background="{Binding FillColor.Color, Converter={StaticResource ColorToBrushConverter}}" CornerRadius="3" BorderBrush="#555" BorderThickness="1"/>
                            <TextBlock Text="Обводка"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Classes="ColorPreview" Height="28" Width="28" Background="{Binding StrokeColor.Color, Converter={StaticResource ColorToBrushConverter}}" CornerRadius="3" BorderBrush="#555" BorderThickness="1"/>
                                <Border Background="#555" CornerRadius="2" Height="28" Width="{Binding StrokeWidth}" MinWidth="1" MaxWidth="20" HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding StrokeWidth, StringFormat='{}{0}px'}" VerticalAlignment="Center" Foreground="#999"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <Slider Minimum="0" Maximum="100" Value="{Binding Opacity, Mode=TwoWay}" TickPlacement="BottomRight"/>
                            <TextBlock Text="{Binding Opacity, StringFormat='{}{0:F0}%'}" HorizontalAlignment="Center" Foreground="#999"/>
                            <Border Height="20" CornerRadius="3" BorderBrush="#555" BorderThickness="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                        <GradientStop Color="{Binding FillColor.Color, Converter={StaticResource DrawingColorConverter}}" Offset="0"/>
                                        <GradientStop Color="Transparent" Offset="{Binding Opacity, Converter={StaticResource PercentToDoubleConverter}}"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Слои">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8" Spacing="4">
                        <Button Content="📄 +" Command="{Binding Commands.CreateNewLayer}" ToolTip.Tip="Создать новый слой для рисования" Width="36" Height="28" HorizontalAlignment="Stretch"/>
                        <Button Content="🗑️" Width="36" Height="28" ToolTip.Tip="Удалить"/>
                        <Button Content="🔒" Width="36" Height="28" ToolTip.Tip="Заблокировать"/>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Canvas.Layers}" SelectedItem="{Binding Canvas.ActiveLayer}" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:LayerViewModel">
                                <Grid ColumnDefinitions="20,*,Auto">
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsVisible}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>
            <TabItem Header="История"/>
        </TabControl>
    </Border>
</UserControl>

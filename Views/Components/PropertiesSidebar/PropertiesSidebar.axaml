<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:graphic_editor.Controls"
             xmlns:vm="using:graphic_editor.ViewModels"
             xmlns:converters="using:graphic_editor.Converters"
             x:Class="graphic_editor.Views.Components.PropertiesSidebar"
             x:DataType="vm:MainWindowViewModel">

    <UserControl.Styles>
        <StyleInclude Source="PropertiesSidebarStyles.axaml"/>
    </UserControl.Styles>

    <UserControl.Resources>
		<converters:InvertedBoolConverter x:Key="InvertedBool"/>
        <converters:IsZeroToVisibleConverter x:Key="IsZeroToVisible"/>
        <converters:ColorToBrushConverter x:Key="ColorToBrushConverter"/>
        <converters:DrawingColorConverter x:Key="DrawingColorConverter"/>
        <converters:PercentToDoubleConverter x:Key="PercentToDoubleConverter"/>
        <converters:MathSubtractConverter x:Key="MathSubtract"/>
		<converters:IsGreaterThanOneConverter x:Key="IsGreaterThanOneConverter"/>
		<converters:BoolToBrushConverter x:Key="BoolToBrushConverter"/>
		<converters:IsGreaterThanZeroConverter x:Key="IsGreaterThanZeroConverter"/>
    </UserControl.Resources>

    <Border Classes="Panel" Width="300" Margin="0,4,4,4">
        <TabControl Background="Transparent" TabStripPlacement="Top">
            
            <!-- Вкладка "Свойства" -->
            <TabItem Header="Свойства">
                <ScrollViewer Padding="12">
                    <StackPanel Spacing="12">
                        
                        <!-- Трансформация -->
                        <TextBlock Text="Трансформация" FontWeight="SemiBold"/>
                        <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto">
                            <TextBlock Text="X:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="120" Classes="PropertyInput"/>
                            <TextBlock Text="Y:" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            <TextBox Grid.Row="0" Grid.Column="3" Text="240" Classes="PropertyInput"/>
                        </Grid>

                        <!-- Внешний вид -->
                        <TextBlock Text="Внешний вид" FontWeight="SemiBold" Margin="0,8,0,4"/>
                        <StackPanel Spacing="8">
                            <TextBlock Text="Заливка"/>
                            <Border Classes="ColorPreview" Height="28" 
                                    Background="{Binding FillColor.Color, Converter={StaticResource ColorToBrushConverter}}" 
                                    CornerRadius="3" BorderBrush="#555" BorderThickness="1"/>
                            
                            <TextBlock Text="Обводка"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Classes="ColorPreview" Height="28" Width="28" 
                                        Background="{Binding StrokeColor.Color, Converter={StaticResource ColorToBrushConverter}}" 
                                        CornerRadius="3" BorderBrush="#555" BorderThickness="1"/>
                                <Border Background="#555" CornerRadius="2" Height="28" 
                                        Width="{Binding StrokeWidth}" MinWidth="1" MaxWidth="20" 
                                        HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding StrokeWidth, StringFormat='{}{0}px'}" 
                                           VerticalAlignment="Center" Foreground="#999"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Прозрачность -->
                        <StackPanel Spacing="8">
                            <Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" 
                                    Value="{Binding Opacity, Mode=TwoWay}" TickPlacement="BottomRight"/>
                            <TextBlock Text="{Binding Opacity, StringFormat='{}{0:F0}%'}" 
                                       HorizontalAlignment="Center" Foreground="#999"/>
                            
                            <!-- Превью прозрачности -->
                            <Border Height="20" CornerRadius="3" BorderBrush="#555" BorderThickness="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                        <GradientStop Color="{Binding FillColor.Color, Converter={StaticResource DrawingColorConverter}}" Offset="0"/>
                                        <GradientStop Color="Transparent" Offset="{Binding Opacity, Converter={StaticResource PercentToDoubleConverter}}"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Вкладка "Слои" с полной логикой -->
            <TabItem Header="Слои">
                <DockPanel>
                    <!-- Кнопки управления слоями -->
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" 
                                HorizontalAlignment="Center" Margin="0,8" Spacing="4">
                        
                        <Button Content="📄 ＋" 
                                Command="{Binding Commands.CreateNewLayer}" 
                                ToolTip.Tip="Создать новый слой"
                                Width="36" Height="28"/>
                        
                        <Button Content="🗑️" 
                                Command="{Binding Commands.DeleteLayerCommand}" 
                                CommandParameter="{Binding Canvas.ActiveLayer}"
                                ToolTip.Tip="Удалить выбранный слой"
                                Width="36" Height="28"
                                IsEnabled="{Binding Canvas.Layers.Count, Converter={StaticResource IsGreaterThanOneConverter}}"/>
                        
                        <Button Content="🔒" 
                                Command="{Binding Commands.ToggleLockLayerCommand}" 
                                CommandParameter="{Binding Canvas.ActiveLayer}"
                                ToolTip.Tip="Заблокировать/разблокировать слой"
                                Width="36" Height="28"/>
                    </StackPanel>
                    
                    <!-- Список слоёв с полным шаблоном -->
                    <ListBox ItemsSource="{Binding Canvas.Layers}" 
                             SelectedItem="{Binding Canvas.ActiveLayer}" 
                             Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:LayerViewModel">
                                <Grid ColumnDefinitions="20,*,Auto,Auto,Auto" Margin="2">
                                    
                                    <!-- Видимость (ToggleButton с командой) -->
                                    <ToggleButton Grid.Column="0" 
                                                  IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                                  Command="{Binding $parent[ListBox].DataContext.Commands.ToggleVisibilityLayerCommand}"
                                                  CommandParameter="{Binding}"
                                                  Content="👁️" 
                                                  FontFamily="Segoe UI Emoji, Segoe UI Symbol, Arial Unicode MS"
                                                  Width="30" Height="30"
                                                  ToolTip.Tip="Показать/скрыть слой"/>
                                    
                                    <!-- Имя слоя (редактируемый TextBox) -->
                                    <TextBox Grid.Column="1" Text="{Binding Name}" Width="120" 
                                             Classes="PropertyInput" Margin="4,0"/>
                                    
                                    <!-- Блокировка (ToggleButton с командой) -->
                                    <ToggleButton Grid.Column="2" 
                                                  IsChecked="{Binding IsLocked, Mode=TwoWay}"
                                                  Command="{Binding $parent[ListBox].DataContext.Commands.ToggleLockLayerCommand}"
                                                  CommandParameter="{Binding}"
                                                  Content="🔓" Width="30" Height="30"
                                                  ToolTip.Tip="Заблокировать/разблокировать слой"/>
                                    
                                    <!-- Удаление (с конвертером IsEnabled) -->
                                    <Button Grid.Column="3" Content="🗑️" Width="30" Height="30"
                                            Command="{Binding $parent[ListBox].DataContext.Commands.DeleteLayerCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="Удалить слой"
                                            IsEnabled="{Binding $parent[ListBox].DataContext.Canvas.Layers.Count, Converter={StaticResource IsGreaterThanOneConverter}}"/>
                                    
                                    <!-- Индикатор видимости -->
                                    <Border Grid.Column="4" Width="8" Height="8" CornerRadius="4"
                                            Background="{Binding IsVisible, Converter={StaticResource BoolToBrushConverter}}"
                                            IsVisible="{Binding IsVisible}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>

            <!-- Вкладка "История" -->
            <TabItem Header="История">
                <TextBlock Text="История действий будет здесь" 
                           HorizontalAlignment="Center" VerticalAlignment="Center" 
                           Foreground="#999"/>
            </TabItem>
        </TabControl>
    </Border>
</UserControl>
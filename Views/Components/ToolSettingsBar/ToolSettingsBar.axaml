<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="using:graphic_editor.Views.Components"
             xmlns:vm="using:graphic_editor.ViewModels"
             x:Class="graphic_editor.Views.Components.ToolSettingsBar"
            xmlns:local="using:graphic_editor.Controls"
            xmlns:views="using:graphic_editor"
            xmlns:converters="using:graphic_editor.Converters"
            x:DataType="vm:MainWindowViewModel">
    <UserControl.Styles>
        <StyleInclude Source="ToolSettingsBarStyles.axaml"/>
    </UserControl.Styles>

    <UserControl.Resources>
        <DrawingBrush x:Key="CheckerBrush" TileMode="Tile" DestinationRect="0,0,16,16">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#252526" Geometry="M0,0 L16,0 16,16 0,16 Z"/>
                    <GeometryDrawing Brush="#2F2F32" Geometry="M0,0 L8,0 8,8 0,8 Z M8,8 L16,8 16,16 8,16 Z"/>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
		<converters:InvertedBoolConverter x:Key="InvertedBool"/>
        <converters:IsZeroToVisibleConverter x:Key="IsZeroToVisible"/>
        <converters:ColorToBrushConverter x:Key="ColorToBrushConverter"/>
        <converters:DrawingColorConverter x:Key="DrawingColorConverter"/>
        <converters:PercentToDoubleConverter x:Key="PercentToDoubleConverter"/>
        <converters:MathSubtractConverter x:Key="MathSubtract"/>
		<converters:IsGreaterThanOneConverter x:Key="IsGreaterThanOneConverter"/>
		<converters:BoolToBrushConverter x:Key="BoolToBrushConverter"/>
		<converters:IsGreaterThanZeroConverter x:Key="IsGreaterThanZeroConverter"/>
    </UserControl.Resources>

    <Border Classes="ThemePanel" Height="36" BorderThickness="0,0,0,1">
        <StackPanel Classes="ParamBackground" Orientation="Horizontal" 
                    VerticalAlignment="Center" Margin="12,0" Spacing="16">
            
            <!-- Название инструмента -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="subtle" Text="Инструмент:" 
                           VerticalAlignment="Center" Foreground="#999"/>
                <TextBlock x:Name="SelectedToolText" Text="Перо" 
                           FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            
            <Separator Classes="DarkSeparator" Width="1" Height="20"/>
            
            <!-- Цвет заливки -->
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="Заливка:" VerticalAlignment="Center"/>
                <Button x:Name="FillColorButton" Width="28" Height="20" Padding="0" 
                        Background="Transparent" BorderThickness="0">
                    <Border Width="28" Height="20" CornerRadius="2" 
                            BorderBrush="#555" BorderThickness="1" 
                            Background="{Binding FillColor.Color, Converter={StaticResource ColorToBrushConverter}}"/>
                </Button>
                <!-- ✅ Popup определён ТОЛЬКО здесь, с IsOpen binding -->
                <Popup x:Name="ColorPopup" Placement="Bottom" 
                       PlacementTarget="{Binding ElementName=FillColorButton}"
                       IsOpen="{Binding IsColorPickerOpen, Mode=TwoWay}">
                    <components:ColorPickerPopup x:Name="ColorPickerControl" Width="220"/>
                </Popup>
            </StackPanel>

            <!-- Цвет обводки -->
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="Обводка:" VerticalAlignment="Center"/>
                <Button x:Name="StrokeColorButton" Width="28" Height="20" Padding="0" 
                        Background="Transparent" BorderThickness="0">
                    <Border Width="28" Height="20" CornerRadius="2" 
                            BorderBrush="#555" BorderThickness="1" 
                            Background="{Binding StrokeColor.Color, Converter={StaticResource ColorToBrushConverter}}"/>
                </Button>
                <!-- ✅ Popup определён ТОЛЬКО здесь, с IsOpen binding -->
                <Popup x:Name="StrokeColorPopup" Placement="Bottom" 
                       PlacementTarget="{Binding ElementName=StrokeColorButton}"
                       IsOpen="{Binding IsStrokeColorPickerOpen, Mode=TwoWay}">
                    <components:ColorPickerPopup x:Name="StrokeColorPickerControl" Width="220"/>
                </Popup>
                <ComboBox Width="80" SelectedIndex="1">
                    <ComboBoxItem Content="Нет"/>
                    <ComboBoxItem Content="1 пкс"/>
                    <ComboBoxItem Content="2 пкс"/>
                </ComboBox>
            </StackPanel>
            
            <!-- Толщина обводки -->
            <Slider x:Name="StrokeSlider" Width="120" Minimum="0" Maximum="100" 
                    Value="{Binding StrokeWidth, Mode=TwoWay}" 
                    TickFrequency="5" IsSnapToTickEnabled="True"/>
            <TextBlock x:Name="StrokePercentText" Text="75%" 
                       VerticalAlignment="Center" Width="40"/>
        </StackPanel>
    </Border>
</UserControl>
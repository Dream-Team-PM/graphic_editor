<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:graphic_editor.ViewModels"
             x:Class="graphic_editor.Views.Components.MainMenuBar"
             xmlns:local="using:graphic_editor.Controls"
            xmlns:views="using:graphic_editor"
            xmlns:converters="using:graphic_editor.Converters"
             x:DataType="vm:MainWindowViewModel">
    <UserControl.Styles>
        <StyleInclude Source="MainMenuBarStyles.axaml"/>
    </UserControl.Styles>

    <UserControl.Resources>
        <DrawingBrush x:Key="CheckerBrush" TileMode="Tile" DestinationRect="0,0,16,16">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#252526" Geometry="M0,0 L16,0 16,16 0,16 Z"/>
                    <GeometryDrawing Brush="#2F2F32" Geometry="M0,0 L8,0 8,8 0,8 Z M8,8 L16,8 16,16 8,16 Z"/>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
		<converters:InvertedBoolConverter x:Key="InvertedBool"/>
        <converters:IsZeroToVisibleConverter x:Key="IsZeroToVisible"/>
        <converters:ColorToBrushConverter x:Key="ColorToBrushConverter"/>
        <converters:DrawingColorConverter x:Key="DrawingColorConverter"/>
        <converters:PercentToDoubleConverter x:Key="PercentToDoubleConverter"/>
        <converters:MathSubtractConverter x:Key="MathSubtract"/>
		<converters:IsGreaterThanOneConverter x:Key="IsGreaterThanOneConverter"/>
		<converters:BoolToBrushConverter x:Key="BoolToBrushConverter"/>
		<converters:IsGreaterThanZeroConverter x:Key="IsGreaterThanZeroConverter"/>
    </UserControl.Resources>

    <Border Classes="ThemePanel" Height="32">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Menu Grid.Column="0"
                  Background="Transparent"
                  HorizontalAlignment="Left">
                <MenuItem Header="_Файл">
                    <MenuItem Header="Новый..." InputGesture="Ctrl+N"/>
                    <MenuItem x:Name="OpenMenuItem" Header="Открыть…" InputGesture="Ctrl+O"/>
                    <MenuItem x:Name="SaveMenuItem" Header="Сохранить" InputGesture="Ctrl+S"/>
                    <MenuItem x:Name="SaveAsMenuItem" Header="Сохранить как…" InputGesture="Ctrl+Shift+S"/>
                    <Separator/>
                    <MenuItem Header="Выход" InputGesture="Alt+F4"/>
                </MenuItem>

                <MenuItem Header="_Правка">
                    <MenuItem Header="Отменить"
                              InputGesture="Ctrl+Z"
                              Command="{Binding History.Undo}"
                              IsEnabled="{Binding History.CanUndo}"/>
                    <MenuItem Header="Повторить"
                              InputGesture="Ctrl+Y"
                              Command="{Binding History.Redo}"
                              IsEnabled="{Binding History.CanRedo}"/>
                    <Separator/>
                    <MenuItem Header="Вырезать" InputGesture="Ctrl+X"/>
                    <MenuItem Header="Копировать" InputGesture="Ctrl+C"/>
                    <MenuItem Header="Вставить" InputGesture="Ctrl+V"/>
                </MenuItem>

                <MenuItem Header="_Вид">
                    <MenuItem Header="Показать линейки" IsChecked="True"/>
                    <MenuItem Header="Показать сетку" IsChecked="True"/>
                    <Separator/>
                    <MenuItem Header="Приблизить"
                              InputGesture="Ctrl+OemPlus"
                              Command="{Binding Commands.ZoomIn}"/>
                    <MenuItem Header="Отдалить"
                              InputGesture="Ctrl+OemMinus"
                              Command="{Binding Commands.ZoomOut}"/>
                    <MenuItem Header="Масштаб 100%"
                              InputGesture="Ctrl+0"
                              Command="{Binding Commands.ZoomFit}"/>
                </MenuItem>
                <MenuItem Header="_Слой">
                    <MenuItem Header="Новый слой" Command="{Binding Commands.CreateNewLayer}" InputGesture="Ctrl+Shift+N"/>
                    
                    <MenuItem Header="Удалить слой" 
                              Command="{Binding Commands.DeleteLayerCommand}" 
                              CommandParameter="{Binding Canvas.ActiveLayer}" 
                              InputGesture="Ctrl+Shift+D"
                              IsEnabled="{Binding Canvas.Layers.Count, Converter={StaticResource IsGreaterThanOneConverter}}"/>
                    
                    <Separator/>
                    
                    <MenuItem Header="Дублировать слой" Command="{Binding Commands.DuplicateLayerCommand}" InputGesture="Ctrl+J"/>
                    
                    <!-- ✅ ИСПРАВЛЕНО: заменено обфусцированное имя на реальную команду -->
                    <MenuItem Header="Объединить с предыдущим" 
                              Command="{Binding Commands.MergeWithPreviousLayerCommand}" 
                              InputGesture="Ctrl+E"
                              IsEnabled="{Binding Canvas.ActiveLayerIndex, Converter={StaticResource IsGreaterThanZeroConverter}}"/>
                    
                    <Separator/>
                    
                    <MenuItem Header="Упорядочить">
                        <MenuItem Header="На передний план" Command="{Binding Commands.BringLayerToFrontCommand}" InputGesture="Ctrl+Shift+OemCloseBrackets"/>
                        <MenuItem Header="На задний план" Command="{Binding Commands.SendLayerToBackCommand}" InputGesture="Ctrl+Shift+OemOpenBrackets"/>
                        <Separator/>
                        <MenuItem Header="Переместить вперед" Command="{Binding Commands.BringLayerForwardCommand}" InputGesture="Ctrl+OemCloseBrackets"/>
                        <MenuItem Header="Переместить назад" Command="{Binding Commands.SendLayerBackwardCommand}" InputGesture="Ctrl+OemOpenBrackets"/>
                    </MenuItem>
                    
                    <Separator/>
                    <MenuItem Header="Свойства слоя..." IsEnabled="False" Foreground="#666"/>
                </MenuItem>

                <!-- Замените пустой <MenuItem Header="_Объект"/> на следующее: -->
                <MenuItem Header="_Объект">
                    <!-- Выделение -->
                    <MenuItem Header="Выделить всё" 
                              Command="{Binding Commands.SelectAllCommand}" 
                              InputGesture="Ctrl+A"/>
                    <MenuItem Header="Снять выделение" 
                              Command="{Binding Commands.DeselectAllCommand}" 
                              InputGesture="Ctrl+Shift+A"/>
                    <Separator/>
                    
                    <!-- Основные действия -->
                    <MenuItem Header="Удалить" 
                              Command="{Binding Commands.DeleteSelected}" 
                              InputGesture="Delete"
                              IsEnabled="{Binding HasSelection}"/>
                    <MenuItem Header="Дублировать" 
                              Command="{Binding Commands.DuplicateSelected}" 
                              InputGesture="Ctrl+D"
                              IsEnabled="{Binding HasSelection}"/>
                    <MenuItem Header="Вырезать" 
                              Command="{Binding Commands.CutSelected}" 
                              InputGesture="Ctrl+X"
                              IsEnabled="{Binding HasSelection}"/>
                    <MenuItem Header="Копировать" 
                              Command="{Binding Commands.CopySelected}" 
                              InputGesture="Ctrl+C"
                              IsEnabled="{Binding HasSelection}"/>
                    <MenuItem Header="Вставить" 
                              Command="{Binding Commands.PasteSelected}" 
                              InputGesture="Ctrl+V"/>
                    <Separator/>
                    
                    <!-- Группировка -->
                    <MenuItem Header="Сгруппировать" 
                              Command="{Binding Commands.GroupSelected}" 
                              InputGesture="Ctrl+G"
                              IsEnabled="{Binding CanGroup}"/>
                    <MenuItem Header="Разгруппировать" 
                              Command="{Binding Commands.UngroupSelected}" 
                              InputGesture="Ctrl+Shift+G"
                              IsEnabled="{Binding CanUngroup}"/>
                    <Separator/>
                    
                    <!-- Порядок отрисовки (Z-order) -->
                    <MenuItem Header="На передний план" 
                              Command="{Binding Commands.BringToFront}" 
                              InputGesture="Ctrl+Shift+OemCloseBrackets"
                              IsEnabled="{Binding HasSelection}"/>
                    <MenuItem Header="На задний план" 
                              Command="{Binding Commands.SendToBack}" 
                              InputGesture="Ctrl+Shift+OemOpenBrackets"
                              IsEnabled="{Binding HasSelection}"/>
                    <MenuItem Header="Переместить вперёд" 
                              Command="{Binding Commands.BringForward}" 
                              InputGesture="Ctrl+OemCloseBrackets"
                              IsEnabled="{Binding HasSelection}"/>
                    <MenuItem Header="Переместить назад" 
                              Command="{Binding Commands.SendBackward}" 
                              InputGesture="Ctrl+OemOpenBrackets"
                              IsEnabled="{Binding HasSelection}"/>
                    <Separator/>
                    
                    <!-- Выравнивание (активно при выделении ≥2 объектов) -->
                    <MenuItem Header="Выровнять">
                        <MenuItem Header="По левому краю" 
                                  Command="{Binding Commands.AlignLeft}" 
                                  IsEnabled="{Binding CanAlign}"/>
                        <MenuItem Header="По центру (горизонтально)" 
                                  Command="{Binding Commands.AlignCenter}" 
                                  IsEnabled="{Binding CanAlign}"/>
                        <MenuItem Header="По правому краю" 
                                  Command="{Binding Commands.AlignRight}" 
                                  IsEnabled="{Binding CanAlign}"/>
                        <Separator/>
                        <MenuItem Header="По верхнему краю" 
                                  Command="{Binding Commands.AlignTop}" 
                                  IsEnabled="{Binding CanAlign}"/>
                        <MenuItem Header="По середине (вертикально)" 
                                  Command="{Binding Commands.AlignMiddle}" 
                                  IsEnabled="{Binding CanAlign}"/>
                        <MenuItem Header="По нижнему краю" 
                                  Command="{Binding Commands.AlignBottom}" 
                                  IsEnabled="{Binding CanAlign}"/>
                    </MenuItem>
                    
                    <!-- Распределение (активно при выделении ≥3 объектов) -->
                    <MenuItem Header="Распределить">
                        <MenuItem Header="Горизонтально" 
                                  Command="{Binding Commands.DistributeHorizontal}" 
                                  IsEnabled="{Binding CanDistribute}"/>
                        <MenuItem Header="Вертикально" 
                                  Command="{Binding Commands.DistributeVertical}" 
                                  IsEnabled="{Binding CanDistribute}"/>
                    </MenuItem>
                    <Separator/>
                    
                    <!-- Трансформации -->
                    <MenuItem Header="Поворот">
                        <MenuItem Header="↶ Влево на 90°" 
                                  Command="{Binding Commands.RotateLeft}" 
                                  InputGesture="Ctrl+OemMinus"
                                  IsEnabled="{Binding HasSelection}"/>
                        <MenuItem Header="↷ Вправо на 90°" 
                                  Command="{Binding Commands.RotateRight}" 
                                  InputGesture="Ctrl+OemPlus"
                                  IsEnabled="{Binding HasSelection}"/>
                        <MenuItem Header="↻ На 180°" 
                                  Command="{Binding Commands.RotateFull}" 
                                  IsEnabled="{Binding HasSelection}"/>
                        <Separator/>
                        <MenuItem Header="Произвольно..." 
                                  Command="{Binding Commands.RotateFreeClick}" 
                                  IsEnabled="{Binding HasSelection}"/>
                    </MenuItem>
                    
                    <MenuItem Header="Отражение">
                        <MenuItem Header="↔ По горизонтали" 
                                  Command="{Binding Commands.FlipHorizontal}" 
                                  IsEnabled="{Binding HasSelection}"/>
                        <MenuItem Header="↕ По вертикали" 
                                  Command="{Binding Commands.FlipVertical}" 
                                  IsEnabled="{Binding HasSelection}"/>
                    </MenuItem>
                    
                    <MenuItem Header="Масштаб">
                        <MenuItem Header="Увеличить на 10%" 
                                  Command="{Binding Commands.ScaleUp}" 
                                  IsEnabled="{Binding HasSelection}"/>
                        <MenuItem Header="Уменьшить на 10%" 
                                  Command="{Binding Commands.ScaleDown}" 
                                  IsEnabled="{Binding HasSelection}"/>
                        <Separator/>
                        <MenuItem Header="По размеру холста" 
                                  Command="{Binding Commands.ScaleToFit}" 
                                  IsEnabled="{Binding HasSelection}"/>
                    </MenuItem>
                    <Separator/>
                    
                    <!-- Стиль -->
                    <MenuItem Header="Заливка">
                        <MenuItem Header="Нет" Command="{Binding Commands.SetFillNone}" IsEnabled="{Binding HasSelection}"/>
                        <Separator/>
                        <MenuItem Header="Красный" Command="{Binding Commands.SetFillColorCommand}" CommandParameter="{x:Static Colors.Red}" IsEnabled="{Binding HasSelection}"/>
                        <MenuItem Header="Зелёный" Command="{Binding Commands.SetFillColorCommand}" CommandParameter="{x:Static Colors.Green}" IsEnabled="{Binding HasSelection}"/>
                        <MenuItem Header="Синий" Command="{Binding Commands.SetFillColorCommand}" CommandParameter="{x:Static Colors.Blue}" IsEnabled="{Binding HasSelection}"/>
                        <MenuItem Header="Жёлтый" Command="{Binding Commands.SetFillColorCommand}" CommandParameter="{x:Static Colors.Yellow}" IsEnabled="{Binding HasSelection}"/>
                        <MenuItem Header="Белый" Command="{Binding Commands.SetFillColorCommand}" CommandParameter="{x:Static Colors.White}" IsEnabled="{Binding HasSelection}"/>
                        <MenuItem Header="Чёрный" Command="{Binding Commands.SetFillColorCommand}" CommandParameter="{x:Static Colors.Black}" IsEnabled="{Binding HasSelection}"/>
                        <Separator/>
                        <MenuItem Header="Выбрать цвет…" 
                                  Command="{Binding Commands.OpenFillColorPickerCommand}" 
                                  IsEnabled="{Binding HasSelection}"/>
                    </MenuItem>
                    
                    <MenuItem Header="Обводка">
                        <MenuItem Header="Нет" Command="{Binding Commands.SetStrokeNone}" IsEnabled="{Binding HasSelection}"/>
                        <Separator/>
                        <MenuItem Header="Красный" Command="{Binding Commands.SetStrokeColorCommand}" CommandParameter="{x:Static Colors.Red}" IsEnabled="{Binding HasSelection}"/>
                        <MenuItem Header="Зелёный" Command="{Binding Commands.SetStrokeColorCommand}" CommandParameter="{x:Static Colors.Green}" IsEnabled="{Binding HasSelection}"/>
                        <MenuItem Header="Синий" Command="{Binding Commands.SetStrokeColorCommand}" CommandParameter="{x:Static Colors.Blue}" IsEnabled="{Binding HasSelection}"/>
                        <MenuItem Header="Жёлтый" Command="{Binding Commands.SetStrokeColorCommand}" CommandParameter="{x:Static Colors.Yellow}" IsEnabled="{Binding HasSelection}"/>
                        <MenuItem Header="Белый" Command="{Binding Commands.SetStrokeColorCommand}" CommandParameter="{x:Static Colors.White}" IsEnabled="{Binding HasSelection}"/>
                        <MenuItem Header="Чёрный" Command="{Binding Commands.SetStrokeColorCommand}" CommandParameter="{x:Static Colors.Black}" IsEnabled="{Binding HasSelection}"/>
                        <Separator/>
                        <MenuItem Header="Выбрать цвет…" 
                                  Command="{Binding Commands.OpenStrokeColorPickerCommand}" 
                                  IsEnabled="{Binding HasSelection}"/>
                    </MenuItem>
                    
                    <MenuItem Header="Толщина линии">
                        <MenuItem Header="1 пкс" Command="{Binding Commands.SetStrokeWidthCommand}" CommandParameter="1" IsEnabled="{Binding HasSelection}"/>
                        <MenuItem Header="2 пкс" Command="{Binding Commands.SetStrokeWidthCommand}" CommandParameter="2" IsEnabled="{Binding HasSelection}"/>
                        <MenuItem Header="3 пкс" Command="{Binding Commands.SetStrokeWidthCommand}" CommandParameter="3" IsEnabled="{Binding HasSelection}"/>
                        <MenuItem Header="5 пкс" Command="{Binding Commands.SetStrokeWidthCommand}" CommandParameter="5" IsEnabled="{Binding HasSelection}"/>
                        <MenuItem Header="10 пкс" Command="{Binding Commands.SetStrokeWidthCommand}" CommandParameter="10" IsEnabled="{Binding HasSelection}"/>
                    </MenuItem>
                    <Separator/>
                    
                    <!-- Свойства -->
                    <MenuItem Header="Свойства объекта..." 
                              Command="{Binding Commands.OpenPropertiesCommand}" 
                              InputGesture="Alt+Enter"
                              IsEnabled="{Binding HasSelection}"/>
                </MenuItem>
                <!-- Меню "Справка" -->
                <MenuItem Header="_Справка">
                    <MenuItem x:Name="AboutMenuItem" Header="О программе..."/>
                    <MenuItem x:Name="ShortcutsMenuItem" Header="Сочетания клавиш..."/>
                    <Separator/>
                    <MenuItem x:Name="DocumentationMenuItem" Header="Документация"/>
                    <MenuItem x:Name="ReportIssueMenuItem" Header="Сообщить об ошибке"/>
                </MenuItem>
            </Menu>

            <StackPanel Classes="Switcher"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,0,14,0"
                        Spacing="4">
                <Button Classes="ToolActionBtn"
                        Content="↶"
                        Width="32"
                        Height="24"
                        VerticalContentAlignment="Center"
                        HorizontalContentAlignment="Center"
                        ToolTip.Tip="Отменить (Ctrl+Z)"
                        Command="{Binding History.Undo}"
                        IsEnabled="{Binding History.CanUndo}"/>

                <Button Classes="ToolActionBtn"
                        Content="↷"
                        Width="32"
                        Height="24"
                        VerticalContentAlignment="Center"
                        HorizontalContentAlignment="Center"
                        ToolTip.Tip="Повторить (Ctrl+Y)"
                        Command="{Binding History.Redo}"
                        IsEnabled="{Binding History.CanRedo}"/>

                <Button x:Name="ExportButton" Content="Экспорт"
                        Background="#0078D4"
                        Foreground="White"
                        Padding="12,4"
                        Height="28"
                        VerticalContentAlignment="Center"
                        HorizontalContentAlignment="Center"/>

                <Border Classes="DarkSeparator"
                        Width="1"
                        Height="20"
                        Margin="4,0"
                        VerticalAlignment="Center"/>

                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="56"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="24"/>
                    </Grid.ColumnDefinitions>

                    <Viewbox Grid.Column="0"
                             Width="24"
                             Height="20"
                             Stretch="Uniform"
                             VerticalAlignment="Center">
                        <TextBlock Classes="ThemeIcon"
                                   Text="🌙"
                                   FontSize="14"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Viewbox>

                    <ToggleSwitch Grid.Column="2"
                                  x:Name="ThemeToggle"
                                  Width="56"
                                  Height="28"
                                  OnContent=""
                                  OffContent=""
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center"
                                  ToolTip.Tip="Переключение темы"/>

                    <Viewbox Grid.Column="3"
                             Width="24"
                             Height="20"
                             Stretch="Uniform"
                             VerticalAlignment="Center">
                        <TextBlock Classes="ThemeIcon"
                                   Text="☀️"
                                   FontSize="14"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Viewbox>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:graphic_editor.ViewModels"
             x:Class="graphic_editor.Views.Components.MainMenuBar"
             x:DataType="vm:MainWindowViewModel">
    <UserControl.Styles>
        <StyleInclude Source="MainMenuBarStyles.axaml"/>
    </UserControl.Styles>

    <Border Classes="ThemePanel" Height="32">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Menu Grid.Column="0"
                  Background="Transparent"
                  HorizontalAlignment="Left">
                <MenuItem Header="_Файл">
                    <MenuItem Header="Новый..." InputGesture="Ctrl+N"/>
                    <MenuItem Header="Открыть..." InputGesture="Ctrl+O"/>
                    <MenuItem Header="Сохранить" InputGesture="Ctrl+S"/>
                    <MenuItem Header="Сохранить как..." InputGesture="Ctrl+Shift+S"/>
                    <Separator/>
                    <MenuItem Header="Выход" InputGesture="Alt+F4"/>
                </MenuItem>

                <MenuItem Header="_Правка">
                    <MenuItem Header="Отменить"
                              InputGesture="Ctrl+Z"
                              Command="{Binding History.Undo}"
                              IsEnabled="{Binding History.CanUndo}"/>
                    <MenuItem Header="Повторить"
                              InputGesture="Ctrl+Y"
                              Command="{Binding History.Redo}"
                              IsEnabled="{Binding History.CanRedo}"/>
                    <Separator/>
                    <MenuItem Header="Вырезать" InputGesture="Ctrl+X"/>
                    <MenuItem Header="Копировать" InputGesture="Ctrl+C"/>
                    <MenuItem Header="Вставить" InputGesture="Ctrl+V"/>
                </MenuItem>

                <MenuItem Header="_Вид">
                    <MenuItem Header="Показать линейки" IsChecked="True"/>
                    <MenuItem Header="Показать сетку" IsChecked="True"/>
                    <Separator/>
                    <MenuItem Header="Приблизить"
                              InputGesture="Ctrl+OemPlus"
                              Command="{Binding Commands.ZoomIn}"/>
                    <MenuItem Header="Отдалить"
                              InputGesture="Ctrl+OemMinus"
                              Command="{Binding Commands.ZoomOut}"/>
                    <MenuItem Header="Масштаб 100%"
                              InputGesture="Ctrl+0"
                              Command="{Binding Commands.ZoomFit}"/>
                </MenuItem>

                <MenuItem Header="_Слой"/>
                <MenuItem Header="_Объект"/>
                <MenuItem Header="_Справка"/>
            </Menu>

            <StackPanel Classes="Switcher"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="0,0,14,0"
                        Spacing="4">
                <Button Classes="ToolActionBtn"
                        Content="↶"
                        Width="32"
                        Height="24"
                        VerticalContentAlignment="Center"
                        HorizontalContentAlignment="Center"
                        ToolTip.Tip="Отменить (Ctrl+Z)"
                        Command="{Binding History.Undo}"
                        IsEnabled="{Binding History.CanUndo}"/>

                <Button Classes="ToolActionBtn"
                        Content="↷"
                        Width="32"
                        Height="24"
                        VerticalContentAlignment="Center"
                        HorizontalContentAlignment="Center"
                        ToolTip.Tip="Повторить (Ctrl+Y)"
                        Command="{Binding History.Redo}"
                        IsEnabled="{Binding History.CanRedo}"/>

                <Button Content="Экспорт"
                        Background="#0078D4"
                        Foreground="White"
                        Padding="12,4"
                        Height="28"
                        VerticalContentAlignment="Center"
                        HorizontalContentAlignment="Center"/>

                <Border Classes="DarkSeparator"
                        Width="1"
                        Height="20"
                        Margin="4,0"
                        VerticalAlignment="Center"/>

                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="56"/>
                        <ColumnDefinition Width="5"/>
                        <ColumnDefinition Width="24"/>
                    </Grid.ColumnDefinitions>

                    <Viewbox Grid.Column="0"
                             Width="24"
                             Height="20"
                             Stretch="Uniform"
                             VerticalAlignment="Center">
                        <TextBlock Classes="ThemeIcon"
                                   Text="🌙"
                                   FontSize="14"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Viewbox>

                    <ToggleSwitch Grid.Column="2"
                                  x:Name="ThemeToggle"
                                  Width="56"
                                  Height="28"
                                  OnContent=""
                                  OffContent=""
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center"
                                  ToolTip.Tip="Переключение темы"/>

                    <Viewbox Grid.Column="3"
                             Width="24"
                             Height="20"
                             Stretch="Uniform"
                             VerticalAlignment="Center">
                        <TextBlock Classes="ThemeIcon"
                                   Text="☀️"
                                   FontSize="14"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Viewbox>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
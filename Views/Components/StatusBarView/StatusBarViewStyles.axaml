<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="Border.ThemeStatusBar">
        <Setter Property="Background" Value="#2C2C2E"/>
        <Setter Property="BorderBrush" Value="#3F3F46"/>
    </Style>
    <Style Selector="Window[RequestedThemeVariant=Light] Border.ThemeStatusBar">
        <Setter Property="Background" Value="#F0F0F0"/>
        <Setter Property="BorderBrush" Value="#D0D0D0"/>
    </Style>
    <Style Selector="Window[RequestedThemeVariant=Light] Border.ThemeStatusBar TextBlock">
        <Setter Property="Foreground" Value="#333333"/>
    </Style>
</Styles>